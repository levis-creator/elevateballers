{
  "buildCommand": "npm run build:vercel",
  "framework": "astro",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/jobs/notification-maintenance",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
