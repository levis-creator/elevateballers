{
  "name": "elevateballers",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && astro dev",
    "dev:ngrok": "node scripts/ngrok-tunnel.js",
    "dev:tunnel": "npm run dev & npm run dev:ngrok",
    "build": "prisma generate && astro build",
    "build:cpanel": "node scripts/build-cpanel.js",
    "build:vercel": "npx cross-env DEPLOY_TARGET=vercel prisma generate && npx cross-env DEPLOY_TARGET=vercel astro build",
    "start": "node server.js",
    "preview:cpanel": "npm run build:cpanel && npm run start",
    "preview": "echo The @astrojs/vercel adapter does not support 'astro preview'. Use 'npm run preview:vercel' instead (requires Vercel CLI) or 'npm run dev' for development.",
    "preview:vercel": "vercel dev",
    "preview:prod": "vercel env pull .env.production && vercel dev",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "deploy:cpanel": "npm run build:cpanel",
    "astro": "astro",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:setup": "node prisma/seed.js",
    "db:permissions": "node prisma/seed-permissions.js",
    "db:sync-permissions": "tsx -e \"import { syncPermissions } from './src/lib/syncPermissions.ts'; syncPermissions().then(() => process.exit(0))\"",
    "db:rbac": "node scripts/enhance-rbac.js",
    "create-admin": "node scripts/create-admin.js",
    "db:migrate-to-production": "tsx scripts/migrate-db-to-production.ts",
    "migrate:media-to-r2": "tsx scripts/migrate-supabase-media-to-r2.ts",
    "initialize:r2-media-folders": "tsx scripts/initialize-r2-media-folders.ts",
    "fix:dates": "node scripts/fix-invalid-dates.js",
    "backfill:match-stages": "tsx scripts/backfill-match-stages.ts",
    "backfill:league-seasons": "tsx scripts/backfill-league-seasons.ts",
    "backfill:season-teams": "node scripts/backfill-season-teams.js",
    "audit:competition": "tsx scripts/audit-competition-structure.ts",
    "audit:league-season-contract": "tsx scripts/audit-league-season-contract.ts",
    "audit:legacy-match-scope": "tsx scripts/audit-legacy-match-scope.ts",
    "repair:legacy-match-scope": "tsx scripts/repair-legacy-match-scope.ts",
    "merge:duplicate-season": "tsx scripts/merge-duplicate-season.ts",
    "migrate:staff-split": "tsx scripts/migrate-staff-split.ts",
    "cleanup:private": "tsx scripts/cleanup-private-info.ts",
    "backup:season-registration:production": "tsx scripts/backup-season-registration-production.ts",
    "audit:season-registration:production": "tsx scripts/audit-season-registration-production.ts",
    "backfill:season-rosters:production": "tsx scripts/backfill-season-rosters-production.ts",
    "verify:phase6:production": "tsx scripts/verify-phase6-production.ts",
    "restore:season-registration:production": "tsx scripts/restore-season-registration-backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "lint:fix": "eslint src --ext .ts,.tsx,.astro --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro}\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@astrojs/vercel": "^11.0.17",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@fontsource/anton": "^5.2.7",
    "@fontsource/archivo": "^5.2.8",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.2.9",
    "@getbrevo/brevo": "^5.0.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-mariadb": "^7.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-table": "^8.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.15.3",
    "@upstash/qstash": "^2.10.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/functions": "^2.2.13",
    "alpinejs": "^3.15.12",
    "astro": "^7.4.4",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "imapflow": "^2.9.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "mailparser": "^3.12.4",
    "motion": "^12.43.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.3.0",
    "oxc-transform-react": "^0.145.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "prisma": "^7.3.0",
    "quill": "^2.0.3",
    "react": "^19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.69.0",
    "react-intersection-observer": "^10.0.0",
    "react-masonry-css": "^1.0.16",
    "resend": "^6.9.3",
    "sanitize-html": "^2.17.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.19",
    "yet-another-react-lightbox": "^3.28.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@ngrok/ngrok": "^1.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "^10.1.0"
    }
  }
}
