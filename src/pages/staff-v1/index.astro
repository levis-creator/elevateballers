---
import ManagedStructuredData from '@/features/settings/presentation/components/ManagedStructuredData.astro';
// Legacy (v1) league-staff directory. `/staff` rewrites here when
// PUBLIC_UI_VERSION !== 'v2'. Guard so it isn't served directly under v2.
import { usePublicV2 } from "@/lib/ui-version";
if (usePublicV2) return Astro.rewrite("/404");

export const prerender = false;

// Edge cache staff directory — changes rarely
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=600'
);

import Layout from "../../layouts/Layout.astro";
import TopBar from "../../features/layout/components/TopBar.astro";
import Header from "../../features/layout/components/Header";
import Footer from "../../features/layout/components/Footer.astro";
import PageLoader from "../../components/PageLoader";
import Spacing from "../../shared/components/ui/Spacing.astro";
import { listLeagueStaff } from "../../features/staff/data/datasources/league-staff-repository";
import PersonCard from "../../features/staff/presentation/components/PersonCard.astro";
import { resolvePublicStaffPageSettings, siteSettingsService } from "../../features/settings";

const settings = resolvePublicStaffPageSettings(await siteSettingsService.list("staff").catch(() => []));

let staff: any[] = [];
try {
  staff = await listLeagueStaff();
} catch (error) {
  console.error("Error fetching league staff:", error);
}

const leadership = settings.leaders
  ? staff.filter((member) => String(member.department).toLowerCase() === "leadership")
  : [];
const directoryStaff = staff.filter((member) => String(member.department).toLowerCase() !== "leadership");
const groupedStaff = directoryStaff.reduce((groups: Record<string, any[]>, member) => {
  const department = member.department || "Operations";
  groups[department] = groups[department] || [];
  groups[department].push(member);
  return groups;
}, {});
const departmentRank = new Map(settings.departments.map((item, index) => [item.name.toLowerCase(), index]));
const departments = Object.keys(groupedStaff).sort((a, b) =>
  (departmentRank.get(a.toLowerCase()) ?? Number.MAX_SAFE_INTEGER) -
    (departmentRank.get(b.toLowerCase()) ?? Number.MAX_SAFE_INTEGER) || a.localeCompare(b)
);
const directorySections = settings.groupByRole
  ? departments.map((name) => ({ name, members: groupedStaff[name] }))
  : directoryStaff.length
    ? [{ name: "Staff", members: directoryStaff.sort((a, b) => a.name.localeCompare(b.name)) }]
    : [];

const pageTitle = `${settings.title} - Elevate Ballers`;
const pageDescription = settings.intro;
const pageUrl = `${Astro.url.origin}/staff/`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageUrl}
  type="website"
>
  <ManagedStructuredData
    content={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["WebPage", "CollectionPage"],
          "@id": pageUrl,
          url: pageUrl,
          name: pageTitle,
          isPartOf: { "@id": `${Astro.url.origin}/#website` },
          description: pageDescription,
          breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
          inLanguage: "en-US",
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${pageUrl}#breadcrumb`,
          itemListElement: [
            {
              "@type": "ListItem",
              position: 1,
              name: "Home",
              item: `${Astro.url.origin}/`,
            },
            { "@type": "ListItem", position: 2, name: "League Staff" },
          ],
        },
      ],
    })}
  />
  <PageLoader client:load />
  <div id="wrapper">
    <TopBar />
    <Header client:load currentPath={Astro.url.pathname} />
    <div id="main">
      <div
        class="stm-title-box-unit transparent-header_on title_box-357"
        style="padding-top: 0; padding-bottom: 0px;"
      ></div>
      <div class="container">
        <section class="wpb-content-wrapper">
          <div class="vc_row wpb_row vc_row-fluid">
            <div class="wpb_column vc_column_container vc_col-sm-12">
              <div class="vc_column-inner">
                <div class="wpb_wrapper">
                  <Spacing
                    id="stm-spacing-staff-header"
                    lg="80"
                    md="70"
                    sm="60"
                    xs="50"
                  />

                  <div class="league-staff-eyebrow">{settings.eyebrow}</div>
                  <h1 class="heading-font" style="text-align: center; margin-bottom: 16px; color: var(--brand);">
                    {settings.title}
                  </h1>
                  <p class="league-staff-intro">
                    {settings.intro}
                  </p>

                  {leadership.length > 0 && (
                    <section class="league-staff-group league-staff-leadership">
                      <div class="league-staff-grid">
                        {leadership.map((member: any) => (
                          <PersonCard name={member.name} role={member.role} photo={member.photo} email={member.email} bio={member.bio} showBio={true} badge={settings.leaderBadge} />
                        ))}
                      </div>
                    </section>
                  )}
                  {directorySections.length > 0 ? (
                    <div class="league-staff-groups">
                      {directorySections.map((section) => (
                        <section class="league-staff-group">
                          {settings.groupByRole && <h2>{section.name}{settings.counts ? ` · ${section.members.length}` : ""}</h2>}
                          <div class="league-staff-grid">
                            {section.members.map((member: any) => (
                              <PersonCard
                                name={member.name}
                                role={member.role}
                                photo={member.photo}
                                email={member.email}
								bio={member.bio}
								showBio={settings.bios}
                              />
                            ))}
                          </div>
                        </section>
                      ))}
                    </div>
                  ) : (
                    <p class="no-data" style="text-align: center;">
                      League staff profiles are being prepared.
                    </p>
                  )}

				  {settings.recruitBlock && (
					<section class="league-staff-recruit">
					  <div><small>{settings.recruitEyebrow}</small><h2>{settings.recruitHeading}</h2><p>{settings.recruitBody}</p></div>
					  <a href="/contacts#officiating">{settings.recruitCta} →</a>
					</section>
				  )}
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
    <Footer />
  </div>
</Layout>

<style>
	.league-staff-eyebrow { margin-bottom: 10px; text-align: center; color: var(--brand); font: 11px "Space Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
  .league-staff-intro {
    max-width: 620px;
    margin: 0 auto 44px;
    text-align: center;
    color: #6f665c;
    font-size: 15px;
    line-height: 1.6;
  }

  .league-staff-groups {
    display: grid;
    gap: 42px;
  }

	.league-staff-leadership { margin-bottom: 42px; }
	.league-staff-recruit { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-top: 48px; padding: 32px; border-radius: 16px; background: #141009; color: #f3efe9; }
	.league-staff-recruit small { color: var(--brandsoft); font: 10px "Space Mono", monospace; letter-spacing: .12em; text-transform: uppercase; }
	.league-staff-recruit h2 { margin: 8px 0; color: inherit; }
	.league-staff-recruit p { max-width: 620px; margin: 0; color: #b8afa6; }
	.league-staff-recruit a { flex: none; padding: 13px 18px; border-radius: 6px; background: var(--brand); color: var(--brandfg, #fff); font-weight: 700; text-decoration: none; }

  .league-staff-group h2 {
    margin: 0 0 18px;
    color: #141009;
    font-family: Teko, sans-serif;
    font-size: 30px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .league-staff-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 960px) {
    .league-staff-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
	.league-staff-recruit { align-items: flex-start; flex-direction: column; }
    .league-staff-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
