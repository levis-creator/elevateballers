---
import ManagedStructuredData from '@/features/settings/presentation/components/ManagedStructuredData.astro';
// Legacy (v1) league-registration page. `/league-registration` rewrites here when
// PUBLIC_UI_VERSION !== 'v2'. Guard so it isn't served directly under v2.
import { usePublicV2 } from "@/lib/ui-version";
if (usePublicV2) return Astro.rewrite("/404");

export const prerender = false;

import Layout from "../layouts/Layout.astro";
import TopBar from "../features/layout/components/TopBar.astro";
import Header from "../features/layout/components/Header";
import Footer from "../features/layout/components/Footer.astro";
import Spacing from "../shared/components/ui/Spacing.astro";
import LeagueRegistrationForm from "../features/registration/components/LeagueRegistrationForm";
import PageLoader from "../components/PageLoader";
import { registrationDeadlines, registrationHeroFacts, registrationWindow, resolvePublicRegistrationSettings, siteSettingsService } from "../features/settings";
const settings = resolvePublicRegistrationSettings(await siteSettingsService.list("registration").catch(() => []));
const formVisible = registrationWindow(settings).open;
const heroFacts = registrationHeroFacts(settings);
const deadlines = registrationDeadlines(settings);
---

<Layout
  title={`${settings.title.replace(/\n/g, " ")} - Elevate Ballers`}
  description={settings.intro}
  canonicalURL={`${Astro.url.origin}/league-registration/`}
  type="website"
>
  <ManagedStructuredData
    content={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": `${Astro.url.origin}/league-registration/`,
          url: `${Astro.url.origin}/league-registration/`,
          name: settings.title.replace(/\n/g, " "),
          isPartOf: { "@id": `${Astro.url.origin}/#website` },
          description: settings.intro,
          breadcrumb: {
            "@id": `${Astro.url.origin}/league-registration/#breadcrumb`,
          },
          inLanguage: "en-US",
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${Astro.url.origin}/league-registration/#breadcrumb`,
          itemListElement: [
            {
              "@type": "ListItem",
              position: 1,
              name: "Home",
              item: `${Astro.url.origin}/`,
            },
            { "@type": "ListItem", position: 2, name: "League Registration" },
          ],
        },
      ],
    })}
  />
  <PageLoader client:load />
  <div id="wrapper">
    <TopBar />
    <Header client:load currentPath={Astro.url.pathname} />
    <div id="main">
      <div
        class="stm-title-box-unit transparent-header_on title_box-357"
        style="padding-top: 0; padding-bottom: 0px;"
      >
      </div>
      <div class="container">
        <section class="wpb-content-wrapper">
          <div class="vc_row wpb_row vc_row-fluid">
            <div class="wpb_column vc_column_container vc_col-sm-12">
              <div class="vc_column-inner">
                <div class="wpb_wrapper">
                  <Spacing
                    id="stm-spacing-registration-header"
                    lg="80"
                    md="70"
                    sm="60"
                    xs="50"
                  />

                  <div class="registration-eyebrow">{settings.eyebrow}</div>
                  <h1
                    class="heading-font"
                    style="text-align: center; margin-bottom: 30px; color: #dd3333;"
                  >
                    {settings.title}
                  </h1>

                  <div
                    class="registration-content"
                    style="max-width: 800px; margin: 0 auto;"
                  >
                    <div
                      class="normal_font"
                      style="line-height: 1.8; color: #363f48; margin-bottom: 40px; text-align: center;"
                    >
                      <p style="margin-bottom: 20px; font-size: 16px;">
                        {settings.intro}
                      </p>
                    </div>

                    <div class="registration-facts">
                      {heroFacts.map((fact) => <div><strong>{fact.big}</strong><span>{fact.small}</span></div>)}
                    </div>

                    <div class="registration-form-wrapper">
                      {formVisible ? (
                        <LeagueRegistrationForm settings={settings} registrationOpen={formVisible} client:load />
                      ) : (
                        <div class="registration-closed"><h2>{settings.closedTitle}</h2><p>{settings.closedBody}</p></div>
                      )}
                    </div>

                    <div class="registration-support-grid">
                      <section><h2>Key Dates</h2>{deadlines.map((item) => <p><strong>{item.date}</strong><span>{item.label}</span></p>)}</section>
                      <section><h2>{settings.stepsHeading}</h2>{settings.steps.map((step, index) => <p><strong>{index + 1}. {step.title}</strong><span>{step.desc}</span></p>)}</section>
                    </div>
                  </div>

                  <Spacing
                    id="stm-spacing-registration-footer"
                    lg="50"
                    md="50"
                    sm="40"
                    xs="40"
                  />
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
    <Footer />

  </div>
  <!--main-->
  <!--wrapper-->

  <div class="rev-close-btn">
    <span class="close-left"></span>
    <span class="close-right"></span>
  </div>

  <script is:inline>
    window.RS_MODULES = window.RS_MODULES || {};
    window.RS_MODULES.modules = window.RS_MODULES.modules || {};
    window.RS_MODULES.waiting = window.RS_MODULES.waiting || [];
    window.RS_MODULES.defered = true;
    window.RS_MODULES.moduleWaiting = window.RS_MODULES.moduleWaiting || {};
    window.RS_MODULES.type = "compiled";
  </script>
  <script is:inline type="speculationrules">
    {
      "prefetch": [
        {
          "source": "document",
          "where": {
            "and": [
              { "href_matches": "/*" },
              {
                "not": {
                  "href_matches": [
                    "/wp-*.php",
                    "/wp-admin/*",
                    "/wp-content/uploads/*",
                    "/wp-content/*",
                    "/wp-content/plugins/*",
                    "/wp-content/themes/elevate/*",
                    "/*\\?(.+)"
                  ]
                }
              },
              { "not": { "selector_matches": "a[rel~=\"nofollow\"]" } },
              { "not": { "selector_matches": ".no-prefetch, .no-prefetch a" } }
            ]
          },
          "eagerness": "conservative"
        }
      ]
    }
  </script>

  <style is:inline type="text/css">
    .sp-footer-sponsors {
      background: #f4f4f4;
      color: #363f48;
    }
    .sp-footer-sponsors .sp-sponsors .sp-sponsors-title {
      color: #363f48;
    }

    /* Smooth scroll behavior - Matching homepage */
    html {
      scroll-behavior: smooth;
    }

    /* Make footer static so it scrolls with the page */
    .stm-footer {
      position: static !important;
    }

    /* Remove extra padding since footer is no longer fixed */
    #main {
      padding-bottom: 0;
    }

    /* Registration page specific styles */
    .wpb_wrapper h2.heading-font {
      font-size: 40px;
      line-height: 44px;
      margin-bottom: 30px;
      color: #dd3333 !important;
    }

    .registration-form input:focus,
    .registration-form textarea:focus,
    .registration-form select:focus {
      border-color: #dd3333;
      outline: none;
    }

    .registration-form button:hover {
      background-color: #c02929 !important;
      transition: background-color 0.3s ease;
    }

    .registration-form label {
      font-family: Rubik;
    }

    .registration-eyebrow { text-align:center; color:var(--site-brand, #dd3333); text-transform:uppercase; letter-spacing:.14em; font-size:12px; margin-bottom:10px; }
    .registration-facts { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:0 auto 32px; }
    .registration-facts div, .registration-closed, .registration-support-grid section { border:1px solid #e2e2e2; border-radius:8px; padding:18px; background:#fff; }
    .registration-facts strong, .registration-facts span, .registration-support-grid strong, .registration-support-grid span { display:block; }
    .registration-facts strong { color:var(--site-brand, #dd3333); font-family:Teko,sans-serif; font-size:28px; }
    .registration-facts span, .registration-support-grid span { color:#68717a; font-size:13px; }
    .registration-closed { text-align:center; margin-bottom:32px; }
    .registration-support-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:32px; }
    .registration-support-grid h2 { font-size:24px; }
    .registration-support-grid p { border-bottom:1px solid #eee; padding:10px 0; margin:0; }

    /* Responsive styles for form grid layouts */
    @media (max-width: 767px) {
      .registration-form [style*="grid-template-columns"] {
        grid-template-columns: 1fr !important;
      }

      .registration-facts, .registration-support-grid { grid-template-columns:1fr; }

      #main {
        padding-bottom: 0;
      }
    }
  </style>

  <div class="sp-header-sponsors" style="margin-top: 10px; margin-right: 10px;">
    <div class="sportspress"><div class="sp-sponsors"></div></div>
  </div>

  <script is:inline type="text/javascript">
    jQuery(document).ready(function ($) {
      $(".sp-header").prepend($(".sp-header-sponsors"));
    });
  </script>

  <style is:inline type="text/css">
    /* Hide reCAPTCHA V3 badge */
    .grecaptcha-badge {
      visibility: hidden !important;
    }
  </style>

  <!-- Legacy Scripts removed in favor of React components -->
</Layout>
<!-- wrapper -->
