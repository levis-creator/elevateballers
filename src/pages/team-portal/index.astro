---
export const prerender = false;

import '@/styles/v2.css';
import '@fontsource/anton';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/space-mono/400.css';

import { getCurrentUser } from '@/features/cms/lib/auth';
import { getTeamPortalAccess, requireActiveTeamContext } from '@/features/team-portal/application/team-portal-access';
import TeamPortalShell from '@/features/team-portal/presentation/TeamPortalShell';

const user = await getCurrentUser(Astro.request);
if (!user) return Astro.redirect(`/login?returnTo=${encodeURIComponent('/team-portal')}`, 302);

const access = await getTeamPortalAccess(user.id);
if (access.status !== 'allowed') {
  const message = access.status === 'no-active-team'
    ? 'Your account is active, but a System Admin has not assigned you to an active team yet.'
    : access.status === 'not-activated'
      ? 'Your portal account has not been activated yet. Check your setup invitation or contact a System Admin.'
      : 'Your account is not currently eligible for Team Portal access.';
  return Astro.redirect(`/unauthorized?reason=${encodeURIComponent(message)}`, 302);
}

const requestedTeam = Astro.url.searchParams.get('team');
const selectedTeam = (await requireActiveTeamContext(user.id, requestedTeam)).team;
const requestedView = Astro.url.searchParams.get('view');
const view = requestedView === 'register' || requestedView === 'roster' || requestedView === 'player' || requestedView === 'lineup' || requestedView === 'stats' || requestedView === 'fixtures' ? requestedView : 'overview';
const playerId = Astro.url.searchParams.get('player');
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Team Portal</title>
    <script is:inline>
      (() => {
        try {
          const raw = localStorage.getItem('team-portal-theme');
          const preference = raw === 'light' || raw === 'dark' || raw === 'system' ? raw : JSON.parse(raw || '{}').state?.theme;
          const theme = preference === 'light' || preference === 'dark'
            ? preference
            : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.teamPortalTheme = theme;
        } catch {
          // The portal defaults to dark until the client store is ready.
        }
      })();
    </script>
  </head>
  <body class="m-0"><TeamPortalShell client:load name={user.name} teams={access.teams} selectedTeamId={selectedTeam.id} view={view} playerId={playerId} /></body>
</html>
