---
export const prerender = false;

import { usePublicV2 } from "@/lib/ui-version";

// v2-only route. Rewrite to the legacy page when the flag is off — URL stays
// /league-registration.
if (!usePublicV2) return Astro.rewrite("/league-registration-v1");

import LayoutV2 from "@/layouts/v2/Layout.astro";
import RegistrationPage from "@/features/registration/presentation/v2/RegistrationPage.astro";
import { resolvePublicPrivacyPolicySettings, resolvePublicRegistrationSettings, siteSettingsService } from "@/features/settings";
const [registrationRecords, privacyRecords] = await Promise.all([
	siteSettingsService.list("registration").catch(() => []),
	siteSettingsService.list("privacy").catch(() => []),
]);
const settings = resolvePublicRegistrationSettings(registrationRecords);
const privacy = resolvePublicPrivacyPolicySettings(privacyRecords);
---

<LayoutV2
	title={`${settings.title.replace(/\n/g, " ")} - Elevate Ballers`}
	description={settings.intro}
	canonicalURL={`${Astro.url.origin}/league-registration/`}
	type="website"
>
	<RegistrationPage settings={settings} privacy={privacy} />
</LayoutV2>
