---
import ManagedStructuredData from '@/features/settings/presentation/components/ManagedStructuredData.astro';
// Legacy (v1) stat-leaders page. `/stats/leaders` rewrites here when
// PUBLIC_UI_VERSION !== 'v2'. Guard so it isn't served directly under v2.
import { usePublicV2 } from "@/lib/ui-version";
if (usePublicV2) return Astro.rewrite("/404");

import Layout from "../../layouts/Layout.astro";
import TopBar from "../../features/layout/components/TopBar.astro";
import Header from "../../features/layout/components/Header";
import Footer from "../../features/layout/components/Footer.astro";
import { isFeatureEnabled } from "../../lib/feature-flags";
import { getLeadersData } from "@/features/stats/domain/usecases/get-leaders-data";
import type { StatKey } from "@/features/stats/domain/entities/leaders-v2";
import { leadersToken, resolvePublicLeadersSettings, siteSettingsService } from "@/features/settings";

export const prerender = false;

const [data, settingRecords] = await Promise.all([getLeadersData(), siteSettingsService.list('leaders').catch(() => [])]);
const settings = resolvePublicLeadersSettings(settingRecords);
const statKeyFor = (name: string): StatKey | null => {
    const normalized = name.toLowerCase().replace(/[^a-z0-9]/g, '');
    if (normalized.startsWith('point')) return 'Points';
    if (normalized.startsWith('rebound')) return 'Rebounds';
    if (normalized.startsWith('assist')) return 'Assists';
    if (normalized.startsWith('steal')) return 'Steals';
    if (normalized.startsWith('block')) return 'Blocks';
    if (normalized.includes('3') || normalized.includes('three')) return '3-Pointers';
    return null;
};
const categories = settings.categories.map((category) => ({ ...category, key: statKeyFor(category.name) })).filter((category): category is typeof category & { key: StatKey } => Boolean(category.key));
const activeSeason = data.defaultSeason;
const allLeaders = categories.map((category) => ({
    label: category.name,
    unit: category.unit,
    leaders: data.rows
        .filter((row) => row.season === activeSeason && row.gp >= settings.minGames)
        .map((row) => ({
            id: row.playerId,
            slug: row.href.split('/').filter(Boolean).pop(),
            imageSrc: '/images/default-player.png',
            displayStat: settings.perGame ? row.vals[category.key].toFixed(1) : Math.round(row.vals[category.key] * row.gp),
            fullName: row.name,
            team: { name: row.team },
        }))
        .sort((a, b) => Number(b.displayStat) - Number(a.displayStat))
        .slice(0, settings.boardRows),
}));

const pageTitle = `${settings.title} - Elevate Ballers`;
const pageDescription =
    "Explore top performers across points, rebounds, assists, and more in Elevate Ballers.";
const pageUrl = `${Astro.url.origin}/stats/leaders/`;
---

<Layout
    title={pageTitle}
    description={pageDescription}
    canonicalURL={pageUrl}
    type="website"
>
  <ManagedStructuredData
    content={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebPage",
          "@id": pageUrl,
          url: pageUrl,
          name: pageTitle,
          isPartOf: { "@id": `${Astro.url.origin}/#website` },
          description: pageDescription,
          breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
          inLanguage: "en-US",
        },
        {
          "@type": "BreadcrumbList",
          "@id": `${pageUrl}#breadcrumb`,
          itemListElement: [
            {
              "@type": "ListItem",
              position: 1,
              name: "Home",
              item: `${Astro.url.origin}/`,
            },
            { "@type": "ListItem", position: 2, name: "Stat Leaders" },
          ],
        },
      ],
    })}
  />
    <div id="wrapper">
        {isFeatureEnabled("layout.topbar") && <TopBar />}
        {
            isFeatureEnabled("layout.header") && (
                <Header client:load currentPath={Astro.url.pathname} />
            )
        }

        <main id="main" class="stats-leaders-page">
            <section class="page-title-section">
                <div class="container">
                    <p class="page-eyebrow">{leadersToken(settings.eyebrow, activeSeason)}</p>
                    <h1 class="page-main-title">
                        {settings.title}
                    </h1>
                    <p class="page-subtitle">
                        The top performers across the league this season.
                    </p>
                </div>
            </section>

            <section class="leaders-grid-section">
                <div class="container">
                    {settings.podium && allLeaders[0]?.leaders.length > 0 && <div class="leaders-podium">
                        {allLeaders[0].leaders.slice(0, 3).map((player, index) => <a href={`/players/${player.slug || player.id}`} class="podium-card"><strong>#{index + 1}</strong><span>{player.fullName}</span><b>{player.displayStat} {allLeaders[0].unit}</b></a>)}
                    </div>}
                    <div class="stats-grid">
                        {
                            allLeaders.map((section) => (
                                <div class="stat-category-card">
                                    <div class="card-header">
                                        <h3>{section.label}</h3>
                                        <span class="unit-tag">
                                            {section.unit}
                                        </span>
                                    </div>
                                    <div class="leaders-list">
                                        {section.leaders.map(
                                            (player, index) => (
                                                <a
                                                    href={`/players/${player.slug || player.id}`}
                                                    class="leader-row"
                                                >
                                                    <div class="rank-badge">
                                                        {index + 1}
                                                    </div>
                                                    <div class="player-thumb">
                                                        <img
                                                            src={
                                                                player.imageSrc
                                                            }
                                                            alt={
                                                                player.fullName
                                                            }
                                                            onerror="this.onerror=null;this.src='/images/default-player.png';"
                                                        />
                                                    </div>
                                                    <div class="player-details">
                                                        <span class="player-name">
                                                            {player.fullName}
                                                        </span>
                                                        <span class="player-team">
                                                            {player.team
                                                                ?.name ||
                                                                "Free Agent"}
                                                        </span>
                                                    </div>
                                                    <div class="stat-value-box">
                                                        <span class="val">
                                                            {player.displayStat}
                                                        </span>
                                                    </div>
                                                </a>
                                            ),
                                        )}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                    <p class="qualification-note">{leadersToken(settings.qualNote, settings.minGames)}</p>
                </div>
            </section>
        </main>

        {isFeatureEnabled("layout.footer") && <Footer />}
    </div>
</Layout>

<style>
    .stats-leaders-page {
        background-color: #f9fafb;
        padding-bottom: 80px;
    }

    .page-eyebrow, .qualification-note { text-align:center; text-transform:uppercase; letter-spacing:.12em; color:#6b7280; }
    .leaders-podium { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-bottom:32px; }
    .podium-card { display:flex; flex-direction:column; gap:8px; padding:24px; border-radius:14px; background:#111827; color:#fff; text-decoration:none; }
    .podium-card strong, .podium-card b { color:var(--brand,#dd3333); }
    @media (max-width: 720px) { .leaders-podium { grid-template-columns:1fr; } }

    .page-title-section {
        padding: 60px 0 40px;
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 40px;
    }

    .page-main-title {
        font-size: 4rem;
        margin: 0;
        line-height: 1;
        color: #111827;
        margin-bottom: 10px;
    }

    .page-subtitle {
        font-size: 1.25rem;
        color: #6b7280;
        margin: 0;
    }

    .text-primary {
        color: #dd3333;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 30px;
    }

    .stat-category-card {
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow:
            0 4px 6px -1px rgba(0, 0, 0, 0.1),
            0 2px 4px -1px rgba(0, 0, 0, 0.06);
        border: 1px solid #e5e7eb;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .stat-category-card:hover {
        transform: translateY(-5px);
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .card-header {
        background: #111827;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header h3 {
        margin: 0;
        color: #ffffff !important;
        font-size: 1.5rem;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .unit-tag {
        background: #dd3333;
        color: #ffffff;
        padding: 2px 8px;
        border-radius: 4px;
        font-weight: 700;
        font-size: 0.75rem;
    }

    .leaders-list {
        padding: 10px 0;
    }

    .leader-row {
        display: flex;
        align-items: center;
        padding: 12px 20px;
        text-decoration: none !important;
        color: inherit;
        transition: background 0.2s ease;
        border-bottom: 1px solid #f3f4f6;
    }

    .leader-row:last-child {
        border-bottom: none;
    }

    .leader-row:hover {
        background-color: #f9fafb;
    }

    .rank-badge {
        width: 24px;
        font-weight: 800;
        color: #9ca3af;
        font-size: 1.1rem;
        font-family: "Teko", sans-serif;
    }

    .leader-row:nth-child(1) .rank-badge {
        color: #dd3333;
        font-size: 1.4rem;
    }

    .player-thumb {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        overflow: hidden;
        background: #f3f4f6;
        margin: 0 15px;
        border: 1px solid #e5e7eb;
    }

    .player-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .player-details {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .player-name {
        font-weight: 700;
        color: #111827;
        font-size: 1.05rem;
        line-height: 1.2;
    }

    .player-team {
        font-size: 0.8rem;
        color: #6b7280;
        text-transform: uppercase;
    }

    .stat-value-box {
        text-align: right;
    }

    .val {
        font-family: "Teko", sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: #111827;
        line-height: 1;
    }

    .leader-row:nth-child(1) .val {
        color: #dd3333;
        font-size: 2.2rem;
    }

    @media (max-width: 768px) {
        .page-main-title {
            font-size: 3rem;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
