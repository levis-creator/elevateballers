---
export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, s-maxage=120, stale-while-revalidate=300");

import { usePublicV2 } from "@/lib/ui-version";

// v2-only route. Rewrite to the legacy page when the flag is off — URL stays /news.
if (!usePublicV2) return Astro.rewrite("/news-v1");

import LayoutV2 from "@/layouts/v2/Layout.astro";
import NewsListPage from "@/features/news/presentation/v2/NewsListPage.astro";
import ManagedStructuredData from "@/features/settings/presentation/components/ManagedStructuredData.astro";
import { resolvePublicNewsListSettings, siteSettingsService } from "@/features/settings";
const settings = resolvePublicNewsListSettings(await siteSettingsService.list("news").catch(() => []));
---

<LayoutV2
	title={`${settings.title} - Elevate Ballers | Match Reports, Interviews & Analysis`}
	description="The latest from Elevate Ballers — match reports, championship coverage, interviews and analysis from Kenya's premier basketball league."
	canonicalURL={`${Astro.url.origin}/news/`}
	type="website"
>
	<ManagedStructuredData
		content={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": ["WebPage", "CollectionPage"],
					"@id": `${Astro.url.origin}/news/#collection`,
					url: `${Astro.url.origin}/news/`,
					name: settings.title,
					description: "The latest from Elevate Ballers — match reports, championship coverage, interviews and analysis from Kenya's premier basketball league.",
					isPartOf: { "@id": `${Astro.url.origin}/#website` },
					breadcrumb: { "@id": `${Astro.url.origin}/news/#breadcrumb` },
					inLanguage: "en-US",
				},
				{
					"@type": "BreadcrumbList",
					"@id": `${Astro.url.origin}/news/#breadcrumb`,
					itemListElement: [
						{ "@type": "ListItem", position: 1, name: "Home", item: `${Astro.url.origin}/` },
						{ "@type": "ListItem", position: 2, name: "News", item: `${Astro.url.origin}/news/` },
					],
				},
			],
		})}
	/>
	<NewsListPage settings={settings} />
</LayoutV2>
