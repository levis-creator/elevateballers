---
import ManagedStructuredData from '@/features/settings/presentation/components/ManagedStructuredData.astro';
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import TopBar from '../../features/layout/components/TopBar.astro';
import Header from '../../features/layout/components/Header';
import Footer from '../../features/layout/components/Footer.astro';
import PageLoader from '../../components/PageLoader';
import Spacing from '../../shared/components/ui/Spacing.astro';
import { Image } from 'astro:assets';
import { getStaffBySlug } from '../../features/cms/lib/queries';
import { getDisplayImageUrl } from '../../lib/asset-url';
import { resolvePublicStaffProfileSettings, siteSettingsService } from '../../features/settings';

const { slug } = Astro.params;
if (!slug) {
  return Astro.rewrite('/404');
}

let staff;
try {
  staff = await getStaffBySlug(slug);
  if (!staff || !staff.approved) {
    return Astro.rewrite('/404');
  }
} catch (error) {
  console.error('Error fetching staff:', error);
  return Astro.rewrite('/404');
}

const fullName = `${staff.firstName} ${staff.lastName}`.trim() || 'Staff Member';
const pageTitle = `${fullName} - Staff - Elevate Ballers`;
const pageDescription = staff.bio || `View ${fullName}'s profile and team assignments.`;
const pageUrl = `${Astro.url.origin}/staff/${slug}/`;
const pageImageSource =
  getDisplayImageUrl(staff.image, Astro.url.origin) ||
  "/images/Elevate_Icon-200x200.png";
const pageImage = pageImageSource.startsWith("http")
  ? pageImageSource
  : new URL(pageImageSource, Astro.url.origin).toString();

const formatRole = (role: string): string =>
  role
    .split('_')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(' ');

const approvedTeams = (staff.teams || []).filter((teamStaff: any) => teamStaff.team?.approved);
const settings = resolvePublicStaffProfileSettings(await siteSettingsService.list('staffMember').catch(() => []));
const tagline = approvedTeams.length
  ? `${formatRole(staff.role)} · ${approvedTeams.map((teamStaff: any) => teamStaff.team.name).join(' · ')}`
  : formatRole(staff.role);
const yearsServed = Math.max(1, new Date().getFullYear() - new Date(staff.createdAt).getFullYear() + 1);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  canonicalURL={pageUrl}
  type="profile"
>
  <ManagedStructuredData content={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": pageUrl,
        "url": pageUrl,
        "name": pageTitle,
        "isPartOf": { "@id": `${Astro.url.origin}/#website` },
        "description": pageDescription,
        "breadcrumb": { "@id": `${pageUrl}#breadcrumb` },
        "inLanguage": "en-US"
      },
      {
        "@type": "BreadcrumbList",
        "@id": `${pageUrl}#breadcrumb`,
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": `${Astro.url.origin}/` },
          { "@type": "ListItem", "position": 2, "name": "Staff", "item": `${Astro.url.origin}/staff` },
          { "@type": "ListItem", "position": 3, "name": fullName }
        ]
      },
      {
        "@type": "Person",
        "name": fullName,
        "jobTitle": formatRole(staff.role),
        "image": pageImage,
        "url": pageUrl
      }
    ]
  })} />

  <PageLoader client:load />
  <div id="wrapper">
    <TopBar />
    <Header client:load currentPath={Astro.url.pathname} />
    <div id="main">
      <div
        class="stm-title-box-unit transparent-header_on title_box-357"
        style="padding-top: 0; padding-bottom: 0px;"
      ></div>
      <div class="container">
        <section class="wpb-content-wrapper">
          <div class="vc_row wpb_row vc_row-fluid">
            <div class="wpb_column vc_column_container vc_col-sm-12">
              <div class="vc_column-inner">
                <div class="wpb_wrapper">
				  <a href="/staff" class="staff-back-link">← {settings.backLink}</a>
                  <Spacing
                    id="stm-spacing-staff-header"
                    lg="80"
                    md="70"
                    sm="60"
                    xs="50"
                  />

                  <div class="staff-profile-header">
                    <div class="staff-profile-content">
                      {
                        staff.image ? (
                          <div class="staff-image-container">
                            <Image
                              src={getDisplayImageUrl(staff.image, Astro.url.origin)!}
                              alt={fullName}
                              width={180}
                              height={180}
                            />
                          </div>
                        ) : (
                          <div class="staff-image-placeholder">
                            <span class="staff-initials">
                              {fullName
                                .split(' ')
                                .map((n) => n[0])
                                .join('')
                                .substring(0, 2)
                                .toUpperCase()}
                            </span>
                          </div>
                        )
                      }
                      <div class="staff-header-info">
                        <h1 class="staff-title">{fullName}</h1>
						{settings.roleEyebrow && <div class="staff-role">{formatRole(staff.role)}</div>}
						{settings.tagline && <p class="staff-tagline">{tagline}</p>}
                        {settings.contactButtons && (staff.email || staff.phone) && (
                          <div class="staff-contact">
                            {staff.email && <a href={`mailto:${staff.email}`}>{staff.email}</a>}
                            {staff.phone && <a href={`tel:${staff.phone}`}>{staff.phone}</a>}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>

                  <Spacing
                    id="stm-spacing-staff-bio"
                    lg="50"
                    md="40"
                    sm="30"
                    xs="20"
                  />

                  {staff.bio && (
                    <div class="staff-bio-section">
					  <h3 class="section-title">{settings.aboutHeading}</h3>
                      <p class="staff-bio">{staff.bio}</p>
                    </div>
                  )}

                  <Spacing
                    id="stm-spacing-staff-teams"
                    lg="50"
                    md="40"
                    sm="30"
                    xs="20"
                  />

				  {approvedTeams.length > 0 && <div class="staff-teams-section">
                    <h3 class="section-title">{settings.dutiesHeading}</h3>
                      <ul class="staff-teams-list">
                        {approvedTeams.map((teamStaff: any) => (
                          <li class="staff-team-item">
                            <a href={`/teams/${teamStaff.team.slug}`}>
                              {teamStaff.team.name}
                            </a>
                            <span class="staff-team-role">
                              {formatRole(teamStaff.role)}
                            </span>
                          </li>
                        ))}
                      </ul>
                  </div>}

				  <Spacing id="stm-spacing-staff-facts" lg="50" md="40" sm="30" xs="20" />
				  <section class="staff-facts-section">
					<h3 class="section-title">{settings.factsHeading}</h3>
					<div class="staff-facts-grid">
					  <div><strong>{yearsServed}</strong><span>Years served</span></div>
					  <div><strong>—</strong><span>Matches worked</span></div>
					  <div><strong>{formatRole(staff.role)}</strong><span>Department</span></div>
					</div>
				  </section>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
    <Footer />
  </div>
</Layout>

<style>
	.staff-back-link { display: inline-block; margin-bottom: 24px; color: var(--brand); font: 11px "Space Mono", monospace; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.staff-tagline { margin: 10px 0 0; color: #6f665c; font-size: 15px; }
	.staff-contact { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
	.staff-contact a { padding: 9px 12px; border: 1px solid rgba(20,16,9,.12); border-radius: 6px; color: var(--brand); text-decoration: none; }
	.staff-facts-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
	.staff-facts-grid > div { padding: 20px; border: 1px solid rgba(20,16,9,.1); border-radius: 12px; background: #fff; }
	.staff-facts-grid strong,.staff-facts-grid span { display: block; }
	.staff-facts-grid strong { color: #141009; font: 28px Teko,sans-serif; }
	.staff-facts-grid span { margin-top: 5px; color: #6f665c; font: 10px "Space Mono",monospace; text-transform: uppercase; }
	@media (max-width:600px) { .staff-facts-grid { grid-template-columns: 1fr; } }
</style>
