---
export const prerender = false;
export const ssr = false;

import AdminLayout from '../../../features/cms/components/AdminLayout.astro';
import AdminNewsDetailV2 from '../../../features/news/presentation/v2/AdminNewsDetailV2';
import NewsFormV2 from '../../../features/news/presentation/v2/NewsFormV2';
import { getNewsArticleById } from '../../../features/cms/lib/queries';
import { sanitizeHtml } from '../../../lib/sanitize';

const { id } = Astro.params;
const editMode = Astro.url.searchParams.get('edit') === '1';
const initialArticle = id && !editMode ? await getNewsArticleById(id) : null;
const initialBodyHtml = initialArticle ? sanitizeHtml(initialArticle.content) : '';
---

<AdminLayout title="Edit News Article - Admin" permission="news_articles:update">
  {editMode ? <NewsFormV2 articleId={id} client:load /> : <AdminNewsDetailV2 articleId={id!} initialArticle={initialArticle} initialBodyHtml={initialBodyHtml} client:load />}
</AdminLayout>

