---
export const prerender = false;
export const ssr = false;

import AdminLayout from '../../../../features/cms/components/AdminLayout.astro';
import MatchDetailView from '../../../../features/cms/components/MatchDetailView';
import MatchDetailV2 from '../../../../features/matches/presentation/v2/MatchDetailV2';
import { usePublicAdminV2 } from '@/lib/admin-ui-version';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/matches', 302);
}
---

<AdminLayout title="Match Details - Admin" permission="matches:read">
  {usePublicAdminV2 ? <MatchDetailV2 matchId={id} client:load /> : <MatchDetailView matchId={id} client:load />}
</AdminLayout>
