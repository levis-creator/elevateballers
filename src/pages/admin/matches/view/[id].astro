---
export const prerender = false;
export const ssr = false;

// Match details open the Match Center, which shows the pre-match, live or
// post-match view for the match's status (same page as the console route).
import AdminLayout from '../../../../features/cms/components/AdminLayout.astro';
import MatchDetailView from '../../../../features/cms/components/MatchDetailView';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/matches', 302);
}
---

<AdminLayout title="Match Center - Admin" permission="matches:read">
  <MatchDetailView matchId={id} client:load />
</AdminLayout>
