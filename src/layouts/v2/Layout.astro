---
// Clean-slate layout for the public redesign (PUBLIC_UI_VERSION=v2).
// Deliberately does NOT import the ~40 legacy WordPress stylesheets that
// Layout.astro pulls in — the v2 UI is built fresh on Tailwind. Keep the Props
// shape identical to Layout.astro so route files can swap between them with no
// prop changes.
// v2-only Tailwind entrypoint — NO v1 CSS (admin.css / design-system.css /
// legacy WordPress styles). See src/styles/v2.css.
import "@/styles/v2.css";
// v2 design fonts, self-hosted via Fontsource (no external Google Fonts request).
import "@fontsource/anton"; // 400 (display headings)
import "@fontsource/archivo-black";
import "@fontsource/archivo/400.css";
import "@fontsource/archivo/500.css";
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "@fontsource/archivo/800.css";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/700.css";
// v2 loading-UI animations (boot splash + skeleton shimmer) — global so every page can use them.
import "@/features/loading/lib/loading.css";
import SEO from "@/components/SEO.astro";
import LoadingSplash from "@/features/loading/presentation/v2/LoadingSplash.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import {
	buildThemeColorPalette,
	resolvePublicBrandSettings,
	resolvePublicConsentSettings,
	resolvePublicSystemSettings,
	resolvePublicSeoSettings,
	resolvePublicMatchPageSettings,
	matchesSeoPath,
	applyTitlePattern,
	siteSettingsService,
} from "@/features/settings";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	imageWidth?: number;
	imageHeight?: number;
	imageType?: string;
	canonicalURL?: string;
	type?: string;
	robots?: string;
	keywords?: string;
	publishedTime?: string;
	modifiedTime?: string;
	prevURL?: string;
	nextURL?: string;
	preloadImage?: string;
	titlePattern?: 'team' | 'player' | 'match' | 'article';
	titleTokens?: Record<string, string | number | null | undefined>;
	allowDuringMaintenance?: boolean;
}

const {
	title,
	description,
	image,
	imageWidth,
	imageHeight,
	imageType,
	canonicalURL,
	type,
	robots,
	keywords,
	publishedTime,
	modifiedTime,
	prevURL,
	nextURL,
	preloadImage,
	titlePattern,
	titleTokens = {},
	allowDuringMaintenance = false,
} = Astro.props;

const brandSettings = resolvePublicBrandSettings(
	await siteSettingsService.list("brand").catch(() => [])
);
const seoSettings = resolvePublicSeoSettings(
	await siteSettingsService.list("seo").catch(() => [])
);
const consentSettings = resolvePublicConsentSettings(
	await siteSettingsService.list("consent").catch(() => [])
);
const systemSettings = resolvePublicSystemSettings(
	await siteSettingsService.list("system").catch(() => [])
);
if (systemSettings.maintenance && !allowDuringMaintenance) {
	return Astro.redirect('/maintenance', 302);
}
const palette = buildThemeColorPalette(brandSettings);

const pattern = titlePattern === 'team'
	? seoSettings.patternTeam
	: titlePattern === 'player'
		? seoSettings.patternPlayer
		: titlePattern === 'match'
			? seoSettings.patternMatch
			: titlePattern === 'article'
				? seoSettings.patternArticle
				: '';
const patternedTitle = pattern ? applyTitlePattern(pattern, titleTokens) : title;
const baseTitle = patternedTitle
	? patternedTitle.replaceAll("Elevate Ballers", brandSettings.siteName)
	: seoSettings.metaTitle.replaceAll("Elevate Ballers", brandSettings.siteName);
const suffixBrand = seoSettings.titleSuffix.replace(/^[\s|—–-]+/, '').trim().toLowerCase();
const resolvedTitle = patternedTitle && seoSettings.titleSuffix && !baseTitle.toLowerCase().includes(suffixBrand)
	? `${baseTitle}${seoSettings.titleSuffix}`
	: baseTitle;
const isExcludedPath = seoSettings.noindexPaths.some(({ path }) =>
	matchesSeoPath(Astro.url.pathname, path || '')
);
const resolvedRobots = !seoSettings.indexing || isExcludedPath
	? 'noindex, nofollow'
	: robots;
const matchSlug = /^\/matches\/([^/]+)\/?$/.exec(Astro.url.pathname)?.[1];
const matchAutoShareCards = matchSlug
	? resolvePublicMatchPageSettings(await siteSettingsService.list("match").catch(() => [])).autoShareCards
	: false;
const resolvedImage = image || (matchAutoShareCards && matchSlug
	? `/api/matches/${encodeURIComponent(matchSlug)}/og.png`
	: seoSettings.ogImage);
const themeStyle = [
	`--site-brand-rgb:${palette.brand}`,
	`--site-brand-light-rgb:${palette.brandLight}`,
	`--site-brand-soft-rgb:${palette.brandSoft}`,
	`--site-brand-foreground-rgb:${palette.brandForeground}`,
	`--site-paper-rgb:${palette.paper}`,
	`--site-paper-raised-rgb:${palette.paperRaised}`,
	`--site-paper-soft-rgb:${palette.paperSoft}`,
	`--site-paper-panel-rgb:${palette.paperPanel}`,
	`--site-paper-border-rgb:${palette.paperBorder}`,
	`--site-night-rgb:${palette.night}`,
	`--site-night-raised-rgb:${palette.nightRaised}`,
	`--site-night-soft-rgb:${palette.nightSoft}`,
	`--site-night-border-rgb:${palette.nightBorder}`,
	`--site-ink-rgb:${palette.ink}`,
	`--site-ink-muted-rgb:${palette.inkMuted}`,
	`--site-ink-soft-rgb:${palette.inkSoft}`,
	`--site-cream-rgb:${palette.cream}`,
	`--site-cream-dim-rgb:${palette.creamDim}`,
	`--brand:${brandSettings.brand}`,
	`--brandlt:rgb(${palette.brandLight})`,
	`--brandsoft:rgb(${palette.brandSoft})`,
	`--brandfg:rgb(${palette.brandForeground})`,
	`--paper:rgb(${palette.paper})`,
	`--paper2:rgb(${palette.paperSoft})`,
	`--panel:rgb(${palette.paperPanel})`,
	`--night:rgb(${palette.night})`,
	`--night2:rgb(${palette.nightRaised})`,
	`--ink:rgb(${palette.ink})`,
	`--muted:rgb(${palette.inkMuted})`,
	`--muted2:rgb(${palette.inkSoft})`,
	`--cream:rgb(${palette.cream})`,
	`--creamdim:rgb(${palette.creamDim})`,
	`--site-font-display:"${brandSettings.display}"`,
	`--site-font-body:"${brandSettings.body}"`,
	`--site-font-label:"${brandSettings.label}"`,
].join(";");
---

<!doctype html>
<html
	lang="en-US"
	style={themeStyle}
	data-uppercase-headings={String(brandSettings.uppercaseHeadings)}
	data-hero-art={String(brandSettings.heroArt)}
	data-animated-counters={String(brandSettings.counters)}
	data-respect-reduced-motion={String(brandSettings.reducedMotion)}
	data-system-skeletons={String(systemSettings.skeletons)}
>
	<head>
		<meta name="format-detection" content="telephone=no" />
		<SEO
			title={resolvedTitle}
			description={description || seoSettings.metaDescription}
			siteName={brandSettings.siteName}
			image={resolvedImage}
			imageWidth={imageWidth}
			imageHeight={imageHeight}
			imageType={imageType}
			canonicalURL={canonicalURL}
			type={type}
			robots={resolvedRobots}
			keywords={keywords}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			prevURL={prevURL}
			nextURL={nextURL}
			canonicalBase={seoSettings.canonicalBase}
			twitterHandle={seoSettings.twitterHandle}
			schemaEnabled={seoSettings.schema}
			verificationCodes={seoSettings.verification}
		/>

		{preloadImage && (
			<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
		)}

		<!-- Fonts are self-hosted via Fontsource (imported above) — no external
		     Google Fonts request. Supabase serves most images. -->
		<link rel="preconnect" href="https://zjnlvnyjsidnelgciqmz.supabase.co" crossorigin />

		<!-- Keep the primary favicon on the site origin so Google can always
		     crawl it, even when the optional CMS media path is unavailable. -->
		<link rel="icon" href="/images/Elevate_Icon-32x32.png" sizes="32x32" type="image/png" />
		<link rel="icon" href="/images/Elevate_Icon-200x200.png" sizes="200x200" type="image/png" />
		<link rel="apple-touch-icon" href="/images/Elevate_Icon-200x200.png" />
	</head>
	<!-- Paper and Ink are the document defaults; individual night sections
	     override them through the same derived theme palette. -->
	<body class="min-h-screen bg-paper text-ink antialiased">
		<!-- Boot splash: shown once per session on first paint, then removed on load. -->
		<LoadingSplash settings={systemSettings} />
		<slot />
		{(consentSettings.enabled || seoSettings.analytics !== 'None') && (
			<CookieConsent provider={seoSettings.analytics} analyticsId={seoSettings.analyticsId} settings={consentSettings} />
		)}
	</body>
</html>
