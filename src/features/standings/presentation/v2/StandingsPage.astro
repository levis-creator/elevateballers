---
// v2 Standings page composition. Reuses the home Header/Footer; the board
// (hero season selector + podium + table + search) is a React+Zustand island.
import Header from "@/features/layout/presentation/v2/Header.astro";
import Footer from "@/features/layout/presentation/v2/Footer.astro";
import StandingsBoard from "./sections/StandingsBoard.tsx";
import { getStandingsData } from "@/features/standings/domain/usecases/get-standings-data";
import { getFooterData } from "@/features/layout/domain/usecases/get-footer-data";
import { applyCompetitionSettings, resolvePublicCompetitionSettings, resolvePublicStandingsSettings, siteSettingsService } from "@/features/settings";

const [data, footer, leagueRecords, standingsRecords] = await Promise.all([
	getStandingsData(), getFooterData(), siteSettingsService.list("leagues"), siteSettingsService.list("standings"),
]);
const competitionSettings = resolvePublicCompetitionSettings(leagueRecords);
const standingsSettings = resolvePublicStandingsSettings(standingsRecords);
const competitions = applyCompetitionSettings(data.competitions, competitionSettings);
---

<div class="min-h-screen overflow-x-hidden bg-paper font-body text-ink2">
	<Header active="standings" />
	<StandingsBoard competitions={competitions} tables={data.tables} defaultLeagueSeasonId={data.defaultLeagueSeasonId} competitionSettings={competitionSettings} settings={standingsSettings} client:load />
	<Footer footer={footer} />
</div>
