---
import { ClientRouter } from 'astro:transitions';
import { checkAuth } from '../../cms/lib/auth-astro';
import AdminShell from './AdminShell';
import AdminShellV2 from '../presentation/v2/AdminShellV2';
import { hasPermission, hasAnyPermission, hasAllPermissions } from '../../rbac/permissions';
import { usePublicAdminV2 } from '@/lib/admin-ui-version';
import {
  buildThemeColorPalette,
  resolvePublicBrandSettings,
  siteSettingsService,
} from '@/features/settings';
import ManagedFavicon from '@/features/settings/presentation/components/ManagedFavicon.astro';
import { cacheGet, cacheSet } from '@/lib/cache';
import '../../../styles/admin.css';
import '../presentation/v2/admin-v2.css';
import '@fontsource/anton';
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/space-mono/400.css';


interface Props {
  title?: string;
  permission?: string;
  permissionsAny?: string[];
  permissionsAll?: string[];
}

const {
  title = 'Admin - Elevate Ballers CMS',
  permission,
  permissionsAny,
  permissionsAll,
} = Astro.props;

const user = await checkAuth(Astro.request);

let redirectUrl: string | null = null;

if (!user) {
  redirectUrl = '/admin/login';
} else if (permission) {
  const allowed = await hasPermission(user.id, permission);
  if (!allowed) redirectUrl = '/unauthorized';
} else if (permissionsAny?.length) {
  const allowed = await hasAnyPermission(user.id, permissionsAny);
  if (!allowed) redirectUrl = '/unauthorized';
} else if (permissionsAll?.length) {
  const allowed = await hasAllPermissions(user.id, permissionsAll);
  if (!allowed) redirectUrl = '/unauthorized';
}

// v2 admin shell is flag-gated (same PUBLIC_ADMIN_UI_VERSION as the auth pages).
// The redesigned dashboard lives at /admin; every other admin page keeps its v1
// content on a light surface inside the v2 chrome until individually redesigned.
const useV2 = usePublicAdminV2;
const adminBrandCacheKey = 'admin:brand-settings:v2';
const cachedAdminBrandSettings = useV2
  ? await cacheGet<ReturnType<typeof resolvePublicBrandSettings>>(adminBrandCacheKey)
  : null;
const adminBrandSettings = useV2
  ? cachedAdminBrandSettings ?? resolvePublicBrandSettings(await siteSettingsService.list('brand').catch(() => []))
  : null;
if (useV2 && !cachedAdminBrandSettings) {
  await cacheSet(adminBrandCacheKey, adminBrandSettings, 300);
}
const adminPalette = adminBrandSettings ? buildThemeColorPalette(adminBrandSettings) : null;

const adminBrandStyle = adminBrandSettings
  ? [
      `--site-brand-rgb:${adminPalette!.brand}`,
      `--site-brand-light-rgb:${adminPalette!.brandLight}`,
      `--site-brand-soft-rgb:${adminPalette!.brandSoft}`,
      `--site-brand-foreground-rgb:${adminPalette!.brandForeground}`,
      `--site-paper-rgb:${adminPalette!.paper}`,
      `--site-paper-raised-rgb:${adminPalette!.paperRaised}`,
      `--site-paper-soft-rgb:${adminPalette!.paperSoft}`,
      `--site-paper-panel-rgb:${adminPalette!.paperPanel}`,
      `--site-paper-border-rgb:${adminPalette!.paperBorder}`,
      `--site-night-rgb:${adminPalette!.night}`,
      `--site-night-raised-rgb:${adminPalette!.nightRaised}`,
      `--site-night-soft-rgb:${adminPalette!.nightSoft}`,
      `--site-night-border-rgb:${adminPalette!.nightBorder}`,
      `--site-ink-rgb:${adminPalette!.ink}`,
      `--site-ink-muted-rgb:${adminPalette!.inkMuted}`,
      `--site-ink-soft-rgb:${adminPalette!.inkSoft}`,
      `--site-cream-rgb:${adminPalette!.cream}`,
      `--site-cream-dim-rgb:${adminPalette!.creamDim}`,
      `--brand:${adminBrandSettings.brand}`,
      `--brandlt:rgb(${adminPalette!.brandLight})`,
      `--brandsoft:rgb(${adminPalette!.brandSoft})`,
      `--brandfg:rgb(${adminPalette!.brandForeground})`,
      `--paper:rgb(${adminPalette!.paper})`,
      `--paper2:rgb(${adminPalette!.paperSoft})`,
      `--panel:rgb(${adminPalette!.paperPanel})`,
      `--night:rgb(${adminPalette!.night})`,
      `--night2:rgb(${adminPalette!.nightRaised})`,
      `--ink:rgb(${adminPalette!.ink})`,
      `--muted:rgb(${adminPalette!.inkMuted})`,
      `--muted2:rgb(${adminPalette!.inkSoft})`,
      `--cream:rgb(${adminPalette!.cream})`,
      `--creamdim:rgb(${adminPalette!.creamDim})`,
    ].join(';')
  : undefined;
const isDashboard = Astro.url.pathname === '/admin' || Astro.url.pathname === '/admin/';
const isTeamsList = Astro.url.pathname === '/admin/teams' || Astro.url.pathname === '/admin/teams/';
const isTeamDetail = /^\/admin\/teams\/view\/[^/]+\/?$/.test(Astro.url.pathname);
const isTeamForm = /^\/admin\/teams\/(new|[^/]+)\/?$/.test(Astro.url.pathname);
const isPlayersList = Astro.url.pathname === '/admin/players' || Astro.url.pathname === '/admin/players/';
const isPlayerDetail = /^\/admin\/players\/[^/]+\/?$/.test(Astro.url.pathname);
const isMediaLibrary = Astro.url.pathname === '/admin/media' || Astro.url.pathname === '/admin/media/';
const isStaffDetail =
  /^\/admin\/staff\/[^/]+\/?$/.test(Astro.url.pathname) &&
  Astro.url.searchParams.get('mode') !== 'edit';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {redirectUrl && <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />}
    <title>{title}</title>
    <ManagedFavicon />
    <ClientRouter />

    <!-- Resolve the loading overlay theme before the React shell is mounted. -->
    <script is:inline>
      (function () {
        try {
          var preference = localStorage.getItem('eb-cms-theme');
          var light = preference === 'light' || (preference !== 'dark' && window.matchMedia('(prefers-color-scheme: light)').matches);
          document.documentElement.dataset.adminTheme = light ? 'light' : 'dark';
        } catch (e) {}
      })();
    </script>

    <!-- Resolve sidebar collapsed state before paint. Stored preference wins; match-detail auto-hides by default. -->
    <script is:inline>
      (function () {
        try {
          var stored = null;
          try { stored = localStorage.getItem('admin-sidebar-collapsed'); } catch (e) {}
          var collapsed;
          if (stored === 'true') collapsed = true;
          else if (stored === 'false') collapsed = false;
          else {
            var match = /^\/admin\/matches\/([^/]+)\/?$/.exec(location.pathname);
            collapsed = !!match && match[1] !== 'new';
          }
            var isMobile = window.innerWidth <= 900;
          if (!isMobile && collapsed) {
            document.documentElement.style.setProperty('--admin-sidebar-width', '0px');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Rubik/Teko are still used by shared and legacy admin surfaces. Keep
         them available in the redesigned shell as well, where those surfaces
         can be rendered inside the v2 chrome. -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css?family=Rubik:regular,bold|Teko:regular,700,300,400,500,600&display=swap"
    />

    <style>
      #admin-navigation-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 9999;
        width: 0;
        height: 2px;
        pointer-events: none;
        opacity: 0;
        background: var(--brand, #e4002b);
        box-shadow: 0 0 12px rgb(var(--site-brand-rgb, 228 0 43) / 0.8);
        transition: width 180ms ease-out, opacity 180ms ease-in;
      }

      #admin-navigation-progress.is-loading {
        opacity: 1;
        transition: width 700ms cubic-bezier(0.2, 0.7, 0.3, 1), opacity 180ms ease-in;
      }

      #admin-navigation-progress.is-complete {
        width: 100%;
        opacity: 1;
        transition: width 160ms ease-out, opacity 220ms ease-in 100ms;
      }

      #admin-navigation-skeleton {
        position: fixed;
        top: 57px;
        right: 0;
        bottom: 0;
        left: var(--admin-sidebar-width, 248px);
        z-index: 20;
        display: none;
        overflow: hidden;
        padding: 24px;
        pointer-events: none;
        background: rgb(var(--site-night-rgb, 12 11 10) / 0.96);
      }

      #admin-navigation-skeleton.is-loading {
        display: block;
      }

      #admin-navigation-skeleton .admin-skeleton-heading {
        width: min(420px, 55%);
        height: 34px;
        margin-bottom: 12px;
      }

      #admin-navigation-skeleton .admin-skeleton-copy {
        width: min(620px, 75%);
        height: 14px;
        margin-bottom: 28px;
      }

      #admin-navigation-skeleton .admin-skeleton-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 18px;
      }

      #admin-navigation-skeleton .admin-skeleton-card {
        height: 104px;
        border-radius: 12px;
      }

      #admin-navigation-skeleton .admin-skeleton-panel {
        min-height: 330px;
        border-radius: 14px;
      }

      #admin-navigation-skeleton .admin-skeleton-heading,
      #admin-navigation-skeleton .admin-skeleton-copy,
      #admin-navigation-skeleton .admin-skeleton-card,
      #admin-navigation-skeleton .admin-skeleton-panel {
        background: linear-gradient(
          100deg,
          rgb(var(--site-night-soft-rgb, 22 21 20)),
          rgb(var(--site-night-border-rgb, 36 35 34) / 0.72),
          rgb(var(--site-night-soft-rgb, 22 21 20))
        );
        background-size: 220% 100%;
        animation: admin-skeleton-shimmer 1.15s ease-in-out infinite;
      }

      /* The skeleton sits outside the React shell, so mirror the shell theme
         here instead of leaving a dark overlay on light-theme navigation. */
      body:has(.eb-root.light) #admin-navigation-skeleton {
        background: rgb(var(--site-paper-rgb, 245 243 239) / 0.96);
      }

      body:has(.eb-root.light) #admin-navigation-skeleton .admin-skeleton-heading,
      body:has(.eb-root.light) #admin-navigation-skeleton .admin-skeleton-copy,
      body:has(.eb-root.light) #admin-navigation-skeleton .admin-skeleton-card,
      body:has(.eb-root.light) #admin-navigation-skeleton .admin-skeleton-panel {
        background: linear-gradient(
          100deg,
          rgb(var(--site-paper-soft-rgb, 250 249 247)),
          rgb(var(--site-paper-border-rgb, 223 220 216) / 0.72),
          rgb(var(--site-paper-soft-rgb, 250 249 247))
        );
        background-size: 220% 100%;
      }

      :root[data-admin-theme="light"] #admin-navigation-skeleton {
        background: rgb(var(--site-paper-rgb, 245 243 239) / 0.96);
      }

      :root[data-admin-theme="light"] #admin-navigation-skeleton .admin-skeleton-heading,
      :root[data-admin-theme="light"] #admin-navigation-skeleton .admin-skeleton-copy,
      :root[data-admin-theme="light"] #admin-navigation-skeleton .admin-skeleton-card,
      :root[data-admin-theme="light"] #admin-navigation-skeleton .admin-skeleton-panel {
        background: linear-gradient(
          100deg,
          rgb(var(--site-paper-soft-rgb, 250 249 247)),
          rgb(var(--site-paper-border-rgb, 223 220 216) / 0.72),
          rgb(var(--site-paper-soft-rgb, 250 249 247))
        );
        background-size: 220% 100%;
      }

      /* Avoid stacking the generic navigation overlay over a module skeleton. */
      body:has(.eb-news-loading, .eb-users-loading, .eb-teams-loading, .eb-form-loading, .eb-detail-loading, .eb-potw-v2-loading) #admin-navigation-skeleton {
        display: none !important;
      }

      @keyframes admin-skeleton-shimmer {
        from { background-position: 120% 0; }
        to { background-position: -120% 0; }
      }

      @media (max-width: 900px) {
        #admin-navigation-skeleton {
          left: 0;
          padding: 18px 16px;
        }

        #admin-navigation-skeleton .admin-skeleton-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      :root {
        --admin-primary: #dd3333;
        --admin-primary-dark: #c02a2a;
        --admin-header-height: 4rem;
        --admin-sidebar-width: 248px;
      }

      *, *::before, *::after {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        background: #f9fafb;
        font-family: 'Rubik', sans-serif;
      }

      /* Keep the legacy Teko headings scoped to the legacy admin shell. The V2
         shell owns its typography (Anton / Archivo / Space Mono), including
         detail-page headers and KPI labels. */
      .flex.min-h-screen .admin-page h1,
      .flex.min-h-screen .admin-page h2,
      .flex.min-h-screen .admin-page h3 {
        font-family: 'Teko', sans-serif;
        font-weight: 600;
        line-height: 1.2;
      }
    </style>
  </head>
  <body>
    <div id="admin-navigation-progress" aria-hidden="true"></div>
    <div id="admin-navigation-skeleton" aria-hidden="true">
      <div class="admin-skeleton-heading"></div>
      <div class="admin-skeleton-copy"></div>
      <div class="admin-skeleton-grid">
        <div class="admin-skeleton-card"></div>
        <div class="admin-skeleton-card"></div>
        <div class="admin-skeleton-card"></div>
        <div class="admin-skeleton-card"></div>
      </div>
      <div class="admin-skeleton-panel"></div>
    </div>
    <script is:inline>
      (function () {
        if (window.__ebAdminNavigationProgressBound) return;
        window.__ebAdminNavigationProgressBound = true;

        function progress() {
          return document.getElementById('admin-navigation-progress');
        }

        function start() {
          const bar = progress();
          if (!bar) return;
          const skeleton = document.getElementById('admin-navigation-skeleton');
          if (skeleton) skeleton.classList.add('is-loading');
          bar.classList.remove('is-complete');
          bar.classList.add('is-loading');
          bar.style.width = '12%';
          window.clearTimeout(window.__ebAdminNavigationProgressTimer);
          window.__ebAdminNavigationProgressTimer = window.setTimeout(function () {
            if (bar.classList.contains('is-loading')) bar.style.width = '78%';
          }, 120);
        }

        function finish() {
          const bar = progress();
          if (!bar) return;
          const skeleton = document.getElementById('admin-navigation-skeleton');
          if (skeleton) skeleton.classList.remove('is-loading');
          window.clearTimeout(window.__ebAdminNavigationProgressTimer);
          bar.classList.remove('is-loading');
          bar.classList.add('is-complete');
          window.setTimeout(function () {
            bar.classList.remove('is-complete');
            bar.style.width = '0';
          }, 380);
        }

        document.addEventListener('astro:before-preparation', start);
        document.addEventListener('astro:after-swap', function () {
          window.requestAnimationFrame(function () {
            const bar = progress();
            if (bar) bar.style.width = '88%';
          });
        });
        document.addEventListener('astro:page-load', finish);
      })();
    </script>
    {redirectUrl ? (
      <div style="display:flex;align-items:center;justify-content:center;height:100vh;font-family:sans-serif;">
        <p>Redirecting to <a href={redirectUrl} style="color:#dd3333;text-decoration:none;font-weight:bold;">{redirectUrl}</a>...</p>
      </div>
      <script is:inline define:vars={{ url: redirectUrl }}>
        window.location.href = url;
      </script>
    ) : useV2 ? (
      <div id="eb-admin-root" class="eb-root h-screen w-full overflow-hidden" style={adminBrandStyle}>
        <script is:inline>
          (function () {
            function applyAdminTheme() {
              try {
                var t = localStorage.getItem('eb-cms-theme');
                var light;
                if (t === 'light') light = true;
                else if (t === 'dark') light = false;
                // default = system: follow the OS colour-scheme preference
                else light = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
                var el = document.getElementById('eb-admin-root');
                if (el) { el.classList.toggle('light', !!light); el.classList.toggle('dark', !light); }
              } catch (e) {}
            }
            // Apply before paint on this (full) load.
            applyAdminTheme();
            // Re-apply after every view-transition swap — the swapped-in page ships
            // a fresh #eb-admin-root with no theme class, so without this the theme
            // resets to default when moving between admin modules. Bind once to
            // `document` (survives swaps).
            if (!window.__ebAdminThemeBound) {
              window.__ebAdminThemeBound = true;
              document.addEventListener('astro:after-swap', applyAdminTheme);
            }
          })();
        </script>
        <AdminShellV2 client:load transition:persist />
            <main class="eb-content eb-scroll ml-[var(--admin-sidebar-width,248px)] h-screen min-h-0 overflow-y-auto pt-[57px] transition-[margin] duration-[280ms] ease-out max-[900px]:ml-0">
          <div class={`mx-auto w-full ${isMediaLibrary ? 'max-w-none p-0' : isStaffDetail || isPlayersList || isPlayerDetail ? 'max-w-[1320px] px-6 py-6' : isDashboard || isTeamsList || isTeamDetail || isTeamForm ? 'max-w-[1280px] px-6 py-6' : 'max-w-[1400px] p-8 max-md:p-4 max-[480px]:p-3'} max-md:px-4 admin-page scroll-smooth`}>
            <slot />
          </div>
        </main>
      </div>
    ) : (
      <div class="flex min-h-screen bg-[#f9fafb] relative w-full font-sans">
        <AdminShell client:load transition:persist />
        <main class="flex-1 ml-[var(--admin-sidebar-width)] pt-[var(--admin-header-height)] min-h-screen w-[calc(100%-var(--admin-sidebar-width))] transition-[margin,width] duration-[280ms] ease-out max-md:ml-0 max-md:w-full max-md:pt-14">
          <div class="p-8 max-w-[1400px] mx-auto w-full max-md:p-4 max-[480px]:p-3 admin-page scroll-smooth">
            <slot />
          </div>
        </main>
      </div>
    )}
  </body>
</html>
