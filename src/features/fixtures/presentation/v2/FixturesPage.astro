---
// v2 Fixtures page composition. Reuses the shared Header/Footer; the board
// (hero season selector + Upcoming/Results toggle + league filter + date-grouped
// match list) is a React+Zustand island.
import Header from "@/features/layout/presentation/v2/Header.astro";
import Footer from "@/features/layout/presentation/v2/Footer.astro";
import FixtureBoard from "./sections/FixtureBoard.tsx";
import { getFixturesData } from "@/features/fixtures/domain/usecases/get-fixtures-data";
import { getFooterData } from "@/features/layout/domain/usecases/get-footer-data";
import { applyCompetitionSettings, resolvePublicCompetitionSettings, resolvePublicFixturesSettings, resolvePublicMatchPageSettings, siteSettingsService } from "@/features/settings";

// Keep public bootstrap below the cPanel pool limit. These calls all touch
// MariaDB; starting five at once can exhaust a three-connection pool and make
// the whole page fall into its generic data-error state.
const data = await getFixturesData();
const footer = await getFooterData();
const leagueRecords = await siteSettingsService.list("leagues");
const fixtureRecords = await siteSettingsService.list("fixtures");
const matchRecords = await siteSettingsService.list("match");
const competitionSettings = resolvePublicCompetitionSettings(leagueRecords);
const settings = resolvePublicFixturesSettings(fixtureRecords);
const matchSettings = resolvePublicMatchPageSettings(matchRecords);
const competitions = applyCompetitionSettings(data.competitions, competitionSettings);
const matches = data.matches.map((match) => ({
	...match,
	league: competitions.find((item) => item.id === match.leagueSeasonId)?.leagueLabel ?? match.league,
	leagueCode: competitions.find((item) => item.id === match.leagueSeasonId)?.leagueCode,
}));
---

<div class="min-h-screen overflow-x-hidden bg-paper font-body text-ink2">
	<Header active="fixtures" />
	<FixtureBoard matches={matches} seasons={[...new Set(competitions.map((item) => item.seasonLabel))]} defaultSeason={competitions[0]?.seasonLabel ?? data.defaultSeason} competitions={competitions} defaultLeagueSeasonId={data.defaultLeagueSeasonId} competitionSettings={competitionSettings} settings={settings} liveBadge={matchSettings.liveBadge} client:load />
	<Footer footer={footer} />
</div>
