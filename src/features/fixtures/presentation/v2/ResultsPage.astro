---
// v2 Results page composition. Reuses the shared Header/Footer and the Fixtures
// data layer (completed matches only); the board (hero + featured latest result
// + league filter + date-grouped final scores) is a React+Zustand island.
import Header from "@/features/layout/presentation/v2/Header.astro";
import Footer from "@/features/layout/presentation/v2/Footer.astro";
import ResultsBoard from "./sections/ResultsBoard.tsx";
import { getFixturesData } from "@/features/fixtures/domain/usecases/get-fixtures-data";
import { getFooterData } from "@/features/layout/domain/usecases/get-footer-data";
import { applyCompetitionSettings, resolvePublicCompetitionSettings, siteSettingsService } from "@/features/settings";

const [data, footer, leagueRecords] = await Promise.all([getFixturesData(), getFooterData(), siteSettingsService.list("leagues")]);
const competitionSettings = resolvePublicCompetitionSettings(leagueRecords);
const competitions = applyCompetitionSettings(data.competitions, competitionSettings);
const matches = data.matches
	.filter((match) => !match.leagueSeasonId || competitions.some((item) => item.id === match.leagueSeasonId))
	.map((match) => {
		const competition = competitions.find((item) => item.id === match.leagueSeasonId);
		return { ...match, league: competition?.leagueLabel ?? match.league, leagueCode: competition?.leagueCode, season: competition?.seasonLabel ?? match.season };
	});
---

<div class="min-h-screen overflow-x-hidden bg-paper font-body text-ink2">
	<Header active="results" />
	<ResultsBoard matches={matches} seasons={[...new Set(competitions.map((item) => item.seasonLabel))]} defaultSeason={competitions[0]?.seasonLabel ?? data.defaultSeason} competitions={competitions} defaultLeagueSeasonId={data.defaultLeagueSeasonId} competitionSettings={competitionSettings} client:load />
	<Footer footer={footer} />
</div>
