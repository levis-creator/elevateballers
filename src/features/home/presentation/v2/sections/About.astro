---
interface Props { eyebrow: string; heading: string; body: string; }
const { eyebrow, heading, body } = Astro.props;
const headingLines = heading.split(/\r?\n/);
---

<section id="about" class="border-t border-black/[0.08] bg-white">
	<div class="mx-auto max-w-[1000px] px-8 py-20 text-center max-[960px]:px-6">
		<div class="mb-[18px] font-mono text-[12px] uppercase tracking-[0.14em] text-brand">{eyebrow}</div>
		<h2 class="mb-6 font-display text-[clamp(34px,4.5vw,56px)] uppercase leading-[0.95] text-ink">{headingLines.map((line, index) => <Fragment>{line}{index < headingLines.length - 1 && <br />}</Fragment>)}</h2>
		<p class="mx-auto mb-8 max-w-[640px] text-[17px] leading-[1.7] text-muted">
			{body}
		</p>
		<a href="/about" class="inline-block rounded border border-black/20 px-[30px] py-[15px] text-[14px] font-bold uppercase tracking-[0.04em] text-ink2 no-underline hover:border-brand hover:text-brand">Read the full story →</a>
	</div>
</section>
