---
// Registration call-to-action band. Content switches on registrationOpen.
interface Props {
	registrationOpen: boolean;
	openEyebrow: string; openHeading: string; openBody: string;
	closedEyebrow: string; closedHeading: string; closedBody: string; closedLabel: string;
	openLabel: string; href: string;
}
const { registrationOpen, openEyebrow, openHeading, openBody, closedEyebrow, closedHeading, closedBody, closedLabel, openLabel, href } = Astro.props;
const heading = registrationOpen ? openHeading : closedHeading;
const headingLines = heading.split(/\r?\n/);
---

<section id="register" class="relative overflow-hidden bg-brand text-brandfg">
	<div class="absolute -bottom-[140px] right-[-100px] h-[420px] w-[420px] rounded-full border-2 border-white/[0.18]"></div>
	<div class="absolute -bottom-10 right-10 h-[220px] w-[220px] rounded-full border-2 border-white/[0.18]"></div>
	<div class="relative mx-auto max-w-[1280px] px-8 py-[70px] max-[960px]:px-6">
		<div class="flex flex-wrap items-center justify-between gap-10">
			<div>
				<div class="mb-4 inline-flex items-center gap-[9px] font-mono text-[12px] uppercase tracking-[0.12em]">
					<span class="inline-block h-2 w-2 rounded-full bg-white"></span>{registrationOpen ? openEyebrow : closedEyebrow}
				</div>
				<h2 class="mb-3.5 font-display text-[clamp(36px,5vw,64px)] uppercase leading-[0.9]">{headingLines.map((line, index) => <Fragment>{line}{index < headingLines.length - 1 && <br />}</Fragment>)}</h2>
				<p class="max-w-[460px] text-[17px] font-semibold">{registrationOpen ? openBody : closedBody}</p>
			</div>
			<a href={href} class="flex-shrink-0 rounded-md bg-night px-9 py-5 font-display text-[16px] uppercase tracking-[0.06em] text-white no-underline hover:bg-black">{registrationOpen ? openLabel : closedLabel}</a>
		</div>
	</div>
</section>
