---
// Players of the Week (dark). Dynamic content: one card per filled award slot
// (a conference, or a single-table league) — Clutch, Grind and EWBL sit side by
// side. A slot with no new winner keeps its last one. A pick made before slots
// existed has no league to label, so it keeps the full-width spotlight.
import type { Potw } from "@/features/home/domain/entities/home-v2";
import type { PublicPlayerOfTheWeekSettings } from "@/features/settings";

interface Props {
	potws: Potw[];
	settings: PublicPlayerOfTheWeekSettings;
}
const { potws, settings } = Astro.props;
const PHOTO_BG = "background:repeating-linear-gradient(45deg,#1a1714,#1a1714 12px,#151210 12px,#151210 24px);";
const CARD_WORDS = 24;
const statsFor = (potw: Potw) => settings.stats.map(({ label }) => potw.stats.find((stat) => stat.label.toLowerCase() === label.toLowerCase()) ?? { label, value: '—' });
const wordsOf = (text: string) => text.trim().split(/\s+/).filter(Boolean);
const excerpt = (text: string) => {
	const words = wordsOf(text);
	return words.length > CARD_WORDS ? `${words.slice(0, CARD_WORDS).join(" ")}…` : text.trim();
};
const single = potws.length === 1 && !potws[0].slotLabel ? potws[0] : null;
// "Player of the Week" reads as "Players of the Week" over more than one card.
const heading = potws.length > 1 ? settings.eyebrow.replace(/^Player\b/, "Players") : settings.eyebrow;
const newest = potws.map((potw) => potw.awardedAt).filter((date): date is string => !!date).sort().at(-1);
const updated = newest ? new Date(newest).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Africa/Nairobi" }) : null;
// Descriptive alt text doubles as image-search context: who, what award, where.
const altFor = (potw: Potw) => [potw.name, potw.teamName, `${settings.eyebrow}${potw.slotDescription ? ` — ${potw.slotDescription}` : ""}`].filter(Boolean).join(", ");
---

<section aria-label={heading} class="relative overflow-hidden border-t border-black/[0.08] bg-night text-cream">
	<div class="absolute inset-0" style="background:radial-gradient(90% 120% at 10% 50%,rgb(var(--site-brand-rgb) / 0.16),transparent 55%);"></div>
	{single ? (
		<div class:list={["relative mx-auto grid max-w-[1280px] items-center px-8 py-[72px] max-[960px]:grid-cols-1 max-[960px]:gap-9 max-[960px]:px-6 max-[960px]:py-[52px]", settings.photo ? "grid-cols-[0.85fr_1.15fr] gap-14" : "grid-cols-1"]}>
			{settings.photo && <div class="relative">
				{single.image ? (
					<img src={single.image} alt={altFor(single)} width="640" height="800" onerror="this.onerror=null;this.src='/images/default-player.png'" class="aspect-[4/5] w-full rounded-[14px] border border-white/10 object-cover max-[600px]:max-w-[320px]" />
				) : (
					<div class="flex aspect-[4/5] items-center justify-center rounded-[14px] border border-white/10 max-[600px]:max-w-[320px]" style={PHOTO_BG}>
						<span class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#6b635a]">player photo</span>
					</div>
				)}
				{settings.teamChip && single.teamLabel && (
					<div class="absolute -bottom-3.5 -left-3.5 rounded-md bg-brand px-4 py-2.5 font-display text-[14px] uppercase tracking-[0.06em] text-brandfg">{single.teamLabel}</div>
				)}
			</div>}
			<article>
				<div class="mb-4 font-mono text-[12px] uppercase tracking-[0.14em] text-brandsoft">{settings.eyebrow}</div>
				<h2 class="mb-2.5 font-display text-[clamp(40px,5vw,68px)] uppercase leading-[0.9] text-[var(--cream,#f6f2ec)]">{settings.profileLink && single.href ? <a href={single.href} class="text-inherit no-underline hover:text-brand">{single.name}</a> : single.name}</h2>
				{settings.tagline && single.tagline && <div class="mb-3 font-display text-[24px] uppercase tracking-[0.04em] text-brandsoft">{single.tagline}</div>}
				{settings.quote && single.description && <p class="mb-7 max-w-[520px] whitespace-pre-line text-[16px] leading-[1.7] text-creamdim">{single.description}</p>}
				{settings.showStats && statsFor(single).length > 0 && (
					<div class="flex gap-10">
						{statsFor(single).map((s) => (
							<div>
								<div class="font-display text-[34px] text-cream">{s.value}</div>
								<div class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted2">{s.label}</div>
							</div>
						))}
					</div>
				)}
			</article>
		</div>
	) : (
		<div class="relative mx-auto max-w-[1280px] px-8 py-[72px] max-[960px]:px-6 max-[960px]:py-[52px]">
			<div class="mb-9">
				{updated && <div class="mb-2.5 font-mono text-[12px] uppercase tracking-[0.14em] text-brandsoft">Updated {updated}</div>}
				<h2 class="font-display text-[clamp(38px,4.5vw,56px)] uppercase leading-[0.92] text-[var(--cream,#f6f2ec)]">{heading}</h2>
			</div>
			<div class="grid grid-cols-3 gap-6 max-[1080px]:grid-cols-2 max-[700px]:grid-cols-1">
				{potws.map((potw) => {
					const stats = settings.showStats ? statsFor(potw) : [];
					const long = wordsOf(potw.description).length > CARD_WORDS;
					return (
						<article class="potw-card flex min-w-0 flex-col overflow-hidden rounded-[14px] border border-white/10 bg-[#151311]">
							{potw.slotLabel && (
								<div class="flex items-center justify-between gap-3 border-b border-white/10 px-5 py-3">
									<span class="min-w-0 truncate font-mono text-[11px] uppercase tracking-[0.12em] text-creamdim">{potw.leagueLabel}</span>
									<span class="flex-shrink-0 rounded bg-brand px-2.5 py-1 font-display text-[13px] uppercase tracking-[0.06em] text-brandfg">{potw.slotLabel}</span>
								</div>
							)}
							{settings.photo && (
								<div class="relative">
									{potw.image ? (
										<img src={potw.image} alt={altFor(potw)} width="640" height="480" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/default-player.png'" class="aspect-[4/3] w-full object-cover object-top" />
									) : (
										<div class="flex aspect-[4/3] items-center justify-center" style={PHOTO_BG}>
											<span class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#6b635a]">player photo</span>
										</div>
									)}
									{settings.teamChip && potw.teamLabel && (
										<div class="absolute bottom-3 left-3 max-w-[calc(100%-24px)] truncate rounded-md bg-night/90 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.08em] text-cream">{potw.teamLabel}</div>
									)}
								</div>
							)}
							<div class="flex flex-1 flex-col p-5">
								<h3 class="mb-1.5 font-display text-[clamp(30px,3vw,40px)] uppercase leading-[0.92] text-[var(--cream,#f6f2ec)]">{settings.profileLink && potw.href ? <a href={potw.href} class="text-inherit no-underline hover:text-brand">{potw.name}</a> : potw.name}</h3>
								{settings.tagline && potw.tagline && <div class="mb-3.5 font-display text-[16px] uppercase tracking-[0.06em] text-brand">{potw.tagline}</div>}
								{settings.quote && potw.description && (
									<>
										<p class="potw-excerpt mb-5 text-[15px] leading-[1.65] text-creamdim" style="text-wrap:pretty;">{excerpt(potw.description)}</p>
										{long && (
											<p class="potw-story mb-5 whitespace-pre-line text-[15px] leading-[1.65] text-creamdim" style="text-wrap:pretty;" hidden>{potw.description}</p>
										)}
									</>
								)}
								{stats.length > 0 && (
									<div class="mt-auto grid gap-4 border-t border-white/10 pt-4" style={`grid-template-columns:repeat(${stats.length},minmax(0,1fr));`}>
										{stats.map((s) => (
											<div class="min-w-0">
												<div class="font-display text-[30px] text-cream">{s.value}</div>
												<div class="truncate font-mono text-[11px] uppercase tracking-[0.08em] text-muted2">{s.label}</div>
											</div>
										))}
									</div>
								)}
								{settings.quote && long && (
									<button type="button" class="potw-toggle mt-5 self-start border-0 bg-transparent p-0 font-mono text-[12px] uppercase tracking-[0.1em] text-cream hover:text-brandsoft" aria-expanded="false">
										<span class="potw-more">Read the story<span class="sr-only"> about {potw.name}</span> →</span>
										<span class="potw-less">Show less ↑</span>
									</button>
								)}
							</div>
						</article>
					);
				})}
			</div>
		</div>
	)}
</section>

<style>
	.potw-card:has(.potw-story:not([hidden])) .potw-excerpt { display: none; }
	.potw-less { display: none; }
	.potw-toggle[aria-expanded="true"] .potw-more { display: none; }
	.potw-toggle[aria-expanded="true"] .potw-less { display: inline; }
</style>

<script>
	// "Read the story" opens the full write-up in place; the card shows only its first lines.
	document.addEventListener("click", (event) => {
		const toggle = (event.target as Element | null)?.closest<HTMLButtonElement>(".potw-toggle");
		const story = toggle?.closest(".potw-card")?.querySelector<HTMLElement>(".potw-story");
		if (!toggle || !story) return;
		story.hidden = !story.hidden;
		toggle.setAttribute("aria-expanded", String(!story.hidden));
	});
</script>
