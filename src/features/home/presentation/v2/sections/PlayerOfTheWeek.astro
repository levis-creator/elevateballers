---
// Player of the Week spotlight (dark). Dynamic content: one card per filled
// award slot (a conference, or a single-table league). A lone pick keeps the
// full-width spotlight; two or more sit side by side.
import type { Potw } from "@/features/home/domain/entities/home-v2";
import type { PublicPlayerOfTheWeekSettings } from "@/features/settings";

interface Props {
	potws: Potw[];
	settings: PublicPlayerOfTheWeekSettings;
}
const { potws, settings } = Astro.props;
const PHOTO_BG = "background:repeating-linear-gradient(45deg,#1a1714,#1a1714 12px,#151210 12px,#151210 24px);";
const CARD_WORDS = 24;
const statsFor = (potw: Potw) => settings.stats.map(({ label }) => potw.stats.find((stat) => stat.label.toLowerCase() === label.toLowerCase()) ?? { label, value: '—' });
const excerpt = (text: string) => {
	const words = text.trim().split(/\s+/).filter(Boolean);
	return words.length > CARD_WORDS ? `${words.slice(0, CARD_WORDS).join(" ")}…` : text.trim();
};
const single = potws.length === 1 ? potws[0] : null;
// Descriptive alt text doubles as image-search context: who, what award, where.
const altFor = (potw: Potw) => [potw.name, potw.teamName, `${settings.eyebrow}${potw.slotDescription ? ` — ${potw.slotDescription}` : ""}`].filter(Boolean).join(", ");
---

<section aria-label={settings.eyebrow} class="relative overflow-hidden border-t border-black/[0.08] bg-night text-cream">
	<div class="absolute inset-0" style="background:radial-gradient(90% 120% at 10% 50%,rgb(var(--site-brand-rgb) / 0.16),transparent 55%);"></div>
	{single ? (
		<div class:list={["relative mx-auto grid max-w-[1280px] items-center px-8 py-[72px] max-[960px]:grid-cols-1 max-[960px]:gap-9 max-[960px]:px-6 max-[960px]:py-[52px]", settings.photo ? "grid-cols-[0.85fr_1.15fr] gap-14" : "grid-cols-1"]}>
			{settings.photo && <div class="relative">
				{single.image ? (
					<img src={single.image} alt={altFor(single)} width="640" height="800" onerror="this.onerror=null;this.src='/images/default-player.png'" class="aspect-[4/5] w-full rounded-[14px] border border-white/10 object-cover max-[600px]:max-w-[320px]" />
				) : (
					<div class="flex aspect-[4/5] items-center justify-center rounded-[14px] border border-white/10 max-[600px]:max-w-[320px]" style={PHOTO_BG}>
						<span class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#6b635a]">player photo</span>
					</div>
				)}
				{settings.teamChip && single.teamLabel && (
					<div class="absolute -bottom-3.5 -left-3.5 rounded-md bg-brand px-4 py-2.5 font-display text-[14px] uppercase tracking-[0.06em] text-brandfg">{single.teamLabel}</div>
				)}
			</div>}
			<article>
				<div class="mb-4 font-mono text-[12px] uppercase tracking-[0.14em] text-brandsoft">{settings.eyebrow}{single.slotLabel && <span class="text-creamdim"> · {single.slotLabel}</span>}</div>
				<h2 class="mb-2.5 font-display text-[clamp(40px,5vw,68px)] uppercase leading-[0.9] text-[var(--cream,#f6f2ec)]">{settings.profileLink && single.href ? <a href={single.href} class="text-inherit no-underline hover:text-brand">{single.name}</a> : single.name}</h2>
				{settings.tagline && single.tagline && <div class="mb-3 font-display text-[24px] uppercase tracking-[0.04em] text-brandsoft">{single.tagline}</div>}
				{settings.quote && single.description && <p class="mb-7 max-w-[520px] whitespace-pre-line text-[16px] leading-[1.7] text-creamdim">{single.description}</p>}
				{settings.showStats && statsFor(single).length > 0 && (
					<div class="flex gap-10">
						{statsFor(single).map((s) => (
							<div>
								<div class="font-display text-[34px] text-cream">{s.value}</div>
								<div class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted2">{s.label}</div>
							</div>
						))}
					</div>
				)}
			</article>
		</div>
	) : (
		<div class="relative mx-auto max-w-[1280px] px-8 py-[72px] max-[960px]:px-6 max-[960px]:py-[52px]">
			<h2 class="mb-9 font-display text-[clamp(32px,4vw,52px)] uppercase leading-[0.9] text-[var(--cream,#f6f2ec)]">{settings.eyebrow}</h2>
			<div class="flex flex-wrap justify-center gap-7">
				{potws.map((potw) => (
					<article class="flex w-[calc((100%-56px)/3)] min-w-0 flex-col max-[960px]:w-full max-[960px]:max-w-[520px]">
						{settings.photo && <div class="relative mb-6">
							{potw.image ? (
								<img src={potw.image} alt={altFor(potw)} width="640" height="800" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/default-player.png'" class="aspect-[4/5] w-full rounded-[14px] border border-white/10 object-cover" />
							) : (
								<div class="flex aspect-[4/5] items-center justify-center rounded-[14px] border border-white/10" style={PHOTO_BG}>
									<span class="font-mono text-[12px] uppercase tracking-[0.14em] text-[#6b635a]">player photo</span>
								</div>
							)}
							{potw.slotLabel && (
								<div class="absolute left-3 top-3 rounded-md px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-cream backdrop-blur" style="background:rgb(0 0 0 / 0.62);">{potw.slotLabel}</div>
							)}
							{settings.teamChip && potw.teamLabel && (
								<div class="absolute -bottom-3 left-3 max-w-[calc(100%-24px)] truncate rounded-md bg-brand px-3 py-2 font-display text-[13px] uppercase tracking-[0.06em] text-brandfg">{potw.teamLabel}</div>
							)}
						</div>}
						{!settings.photo && potw.slotLabel && <div class="mb-3 font-mono text-[12px] uppercase tracking-[0.14em] text-brandsoft">{potw.slotLabel}</div>}
						<h3 class="mb-2 font-display text-[clamp(28px,2.6vw,38px)] uppercase leading-[0.95] text-[var(--cream,#f6f2ec)]">{settings.profileLink && potw.href ? <a href={potw.href} class="text-inherit no-underline hover:text-brand">{potw.name}</a> : potw.name}</h3>
						{settings.tagline && potw.tagline && <div class="mb-2.5 font-display text-[19px] uppercase tracking-[0.04em] text-brandsoft">{potw.tagline}</div>}
						{settings.quote && potw.description && (
							<p class="mb-5 text-[15px] leading-[1.65] text-creamdim">
								{excerpt(potw.description)}
								{potw.href && potw.description.trim().split(/\s+/).length > CARD_WORDS && <a href={potw.href} class="ml-1 whitespace-nowrap text-brandsoft no-underline hover:text-brand">Read more<span class="sr-only"> about {potw.name}</span></a>}
							</p>
						)}
						{settings.showStats && statsFor(potw).length > 0 && (
							<div class="mt-auto flex gap-7">
								{statsFor(potw).map((s) => (
									<div>
										<div class="font-display text-[28px] text-cream">{s.value}</div>
										<div class="font-mono text-[10px] uppercase tracking-[0.08em] text-muted2">{s.label}</div>
									</div>
								))}
							</div>
						)}
					</article>
				))}
			</div>
		</div>
	)}
</section>
