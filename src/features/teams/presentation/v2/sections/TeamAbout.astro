---
import type { TeamDetail } from '@/features/teams/domain/entities/team-detail';
import { teamPageToken, type PublicTeamPageSettings } from '@/features/settings';
interface Props { detail: TeamDetail; settings: PublicTeamPageSettings }
const { detail, settings } = Astro.props;
const body = detail.description || teamPageToken(settings.aboutFallback, detail.name);
---

{settings.aboutBlock && (
  <section class="mx-auto grid max-w-[1280px] grid-cols-[1.15fr_.85fr] items-center gap-10 px-8 py-[56px] max-[760px]:grid-cols-1 max-[960px]:px-6 max-[960px]:py-10">
    <div>
      <div class="mb-3 font-mono text-[11px] uppercase tracking-[.14em] text-brand">{settings.aboutEyebrow}</div>
      <h2 class="font-display text-[34px] uppercase leading-none text-ink">{detail.name}</h2>
      <p class="mt-4 max-w-[680px] whitespace-pre-line text-[15px] leading-[1.75] text-muted">{body}</p>
    </div>
    {detail.aboutImage && <div class="overflow-hidden rounded-2xl border border-black/10 bg-white p-8"><img src={detail.aboutImage} alt={detail.name} class="mx-auto h-[220px] w-full object-contain" loading="lazy" /></div>}
  </section>
)}
