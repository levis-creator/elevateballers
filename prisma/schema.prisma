generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model User {
  id                        String                          @id @default(cuid())
  email                     String                          @unique
  passwordHash              String                          @map("password_hash")
  name                      String
  phone                     String?
  active                    Boolean                         @default(true)
  activatedAt               DateTime?                       @map("activated_at")
  tokenVersion              Int                             @default(0) @map("token_version")
  failedLoginAttempts       Int                             @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?                       @map("locked_until")
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  comments                  Comment[]
  uploadedMedia             Media[]                         @relation("MediaUploader")
  newsArticles              NewsArticle[]
  articleRevisions          NewsArticleRevision[]
  userRoles                 UserRole[]
  passwordResetTokens       PasswordResetToken[]
  notificationSettings      UserNotificationSetting?
  twoFactorOtps             TwoFactorOtp[]
  emailHistory              UserEmailHistory[]
  seasonRegistrationReviews SeasonRegistrationApplication[] @relation("SeasonRegistrationReviewer")
  teamOwnerships            TeamOwnership[]
  sessions                  UserSession[]
  passwordHistory           PasswordHistory[]
  staffTransfersCreated     StaffTransfer[]                 @relation("StaffTransferActor")
  staffProfile              Staff?

  @@map("users")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime? @map("last_seen_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model UserNotificationSetting {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  enabled          Boolean  @default(true)
  emailEnabled     Boolean  @default(true) @map("email_enabled")
  emailPreferences Json?    @map("email_preferences")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification_settings")
}

model LoginEvent {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  email      String
  success    Boolean
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([email])
  @@index([success])
  @@index([createdAt])
  @@map("login_events")
}

model UserAuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  action      String
  performedBy String   @map("performed_by")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("user_audit_logs")
}

model UserEmailHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  oldEmail  String   @map("old_email")
  newEmail  String   @map("new_email")
  changedBy String   @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_email_history")
}

model TwoFactorOtp {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  attemptCount Int       @default(0) @map("attempt_count")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_otps")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  userRoles   UserRole[]

  @@index([name])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      String
  description String?
  category    String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model NewsArticle {
  id             String                @id @default(cuid())
  title          String
  slug           String                @unique
  content        String                @db.LongText
  excerpt        String?
  category       String
  image          String?
  tags           Json?
  leagueSeasonId String?               @map("league_season_id")
  published      Boolean               @default(false)
  publishedAt    DateTime?             @map("published_at")
  authorId       String                @map("author_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  feature        Boolean               @default(false)
  comments       Comment[]
  metadata       NewsArticleMetadata?
  events         NewsArticleEvent[]
  revisions      NewsArticleRevision[]
  author         User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  leagueSeason   LeagueSeason?         @relation(fields: [leagueSeasonId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([publishedAt])
  @@index([published])
  @@index([feature])
  @@index([authorId])
  @@index([leagueSeasonId])
  @@index([published, publishedAt], map: "news_published_feed_idx")
  @@index([feature, publishedAt], map: "news_featured_feed_idx")
  @@map("news_articles")
}

model NewsArticleMetadata {
  id                String      @id @default(cuid())
  articleId         String      @unique @map("article_id")
  seoTitle          String?     @map("seo_title")
  seoDescription    String?     @map("seo_description")
  canonicalUrl      String?     @map("canonical_url")
  socialTitle       String?     @map("social_title")
  socialDescription String?     @map("social_description")
  socialImage       String?     @map("social_image")
  imageAlt          String?     @map("image_alt")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  article           NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("news_article_metadata")
}

enum NewsArticleEventType {
  VIEW
  SHARE
  COPY_LINK
  COMMENT
}

model NewsArticleEvent {
  id        String               @id @default(cuid())
  articleId String               @map("article_id")
  type      NewsArticleEventType
  sessionId String?              @map("session_id")
  userId    String?              @map("user_id")
  createdAt DateTime             @default(now()) @map("created_at")
  article   NewsArticle          @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, type])
  @@index([articleId, createdAt])
  @@map("news_article_events")
}

model NewsArticleRevision {
  id             String      @id @default(cuid())
  articleId      String      @map("article_id")
  version        Int
  title          String
  slug           String
  content        String      @db.LongText
  excerpt        String?
  category       String
  image          String?
  tags           Json?
  leagueSeasonId String?     @map("league_season_id")
  published      Boolean
  feature        Boolean
  publishedAt    DateTime?   @map("published_at")
  changedById    String?     @map("changed_by_id")
  changeNote     String?     @map("change_note")
  createdAt      DateTime    @default(now()) @map("created_at")
  article        NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy      User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([articleId, version])
  @@index([articleId, createdAt])
  @@map("news_article_revisions")
}

model League {
  id                   String         @id @default(cuid())
  name                 String         @unique
  slug                 String         @unique
  description          String?
  logo                 String?
  active               Boolean        @default(true)
  registrationOpen     Boolean        @default(true) @map("registration_open")
  registrationOpensAt  DateTime?      @map("registration_opens_at")
  registrationClosesAt DateTime?      @map("registration_closes_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  matches              Match[]
  leagueSeasons        LeagueSeason[]
  seasonTeams          SeasonTeam[]

  @@index([name])
  @@index([slug])
  @@index([active])
  @@map("leagues")
}

model Season {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String
  description          String?
  startDate            DateTime          @map("start_date")
  endDate              DateTime          @map("end_date")
  active               Boolean           @default(true)
  registrationOpensAt  DateTime?         @map("registration_opens_at")
  registrationClosesAt DateTime?         @map("registration_closes_at")
  bracketType          String?           @map("bracket_type")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  matches              Match[]
  leagueSeasons        LeagueSeason[]
  seasonTeams          SeasonTeam[]
  conferences          Conference[]
  teamStaffMembers     TeamStaffMember[]

  @@unique([slug])
  @@index([name])
  @@index([active])
  @@index([startDate])
  @@index([endDate])
  @@index([bracketType])
  @@map("seasons")
}

// Join table: a season can run in many leagues and a league runs many seasons.
// Cascades on both sides delete only the link — the season survives league deletion.
model LeagueSeason {
  id                       String                          @id @default(cuid())
  leagueId                 String                          @map("league_id")
  seasonId                 String                          @map("season_id")
  startDate                DateTime                        @map("start_date")
  endDate                  DateTime                        @map("end_date")
  registrationOpensAt      DateTime?                       @map("registration_opens_at")
  registrationClosesAt     DateTime?                       @map("registration_closes_at")
  status                   LeagueSeasonStatus              @default(DRAFT)
  competitionStructure     CompetitionStructure            @default(SINGLE_TABLE) @map("competition_structure")
  bracketType              String?                         @map("bracket_type")
  createdAt                DateTime                        @default(now()) @map("created_at")
  league                   League                          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season                   Season                          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  conferences              Conference[]                    @relation("LeagueSeasonConferences")
  newsArticles             NewsArticle[]
  seasonTeams              SeasonTeam[]                    @relation("LeagueSeasonTeams")
  matches                  Match[]                         @relation("LeagueSeasonMatches")
  registrationApplications SeasonRegistrationApplication[]
  seasonTeamPlayers        SeasonTeamPlayer[]
  seasonPlayerTransfers    SeasonPlayerTransfer[]
  seasonRosterHistory      SeasonRosterHistory[]
  staffAssignments         TeamStaff[]                     @relation("LeagueSeasonStaffAssignments")

  @@unique([leagueId, seasonId])
  @@index([seasonId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("league_seasons")
}

// Competition-edition grouping of teams (e.g. East / West).
model Conference {
  id             String       @id @default(cuid())
  seasonId       String       @map("season_id")
  leagueSeasonId String       @map("league_season_id")
  name           String
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  season         Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  leagueSeason   LeagueSeason @relation("LeagueSeasonConferences", fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  seasonTeams    SeasonTeam[]

  @@unique([leagueSeasonId, name])
  @@index([seasonId])
  @@index([leagueSeasonId])
  @@map("conferences")
}

model Match {
  id                    String            @id @default(cuid())
  slug                  String?           @unique
  team1Name             String?           @map("team1_name")
  team1Logo             String?           @map("team1_logo")
  team2Name             String?           @map("team2_name")
  team2Logo             String?           @map("team2_logo")
  date                  DateTime
  team1Score            Int?              @map("team1_score")
  team2Score            Int?              @map("team2_score")
  status                MatchStatus       @default(UPCOMING)
  resultPublishedAt     DateTime?         @map("result_published_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  leagueId              String?           @map("league_id")
  leagueName            String?           @map("league_name")
  seasonId              String?           @map("season_id")
  leagueSeasonId        String?           @map("league_season_id")
  team1Id               String?           @map("team1_id")
  team2Id               String?           @map("team2_id")
  stage                 MatchStage?
  gameRulesId           String?           @map("game_rules_id")
  currentPeriod         Int               @default(1) @map("current_period")
  clockSeconds          Int?              @map("clock_seconds")
  clockRunning          Boolean           @default(false) @map("clock_running")
  clockStartedAt        DateTime?         @map("clock_started_at")
  clockSecondsAtStart   Int?              @map("clock_seconds_at_start")
  possessionTeamId      String?           @map("possession_team_id")
  team1Timeouts         Int               @default(0) @map("team1_timeouts")
  team2Timeouts         Int               @default(0) @map("team2_timeouts")
  team1Fouls            Int               @default(0) @map("team1_fouls")
  team2Fouls            Int               @default(0) @map("team2_fouls")
  duration              Int?              @map("duration")
  trackingMode          GameTrackingMode  @default(BOTH) @map("tracking_mode")
  winnerId              String?           @map("winner_id")
  nextWinnerMatchId     String?           @map("next_winner_match_id")
  nextLoserMatchId      String?           @map("next_loser_match_id")
  bracketPosition       Int?              @map("bracket_position")
  bracketRound          Int?              @map("bracket_round")
  bracketType           String?           @map("bracket_type")
  gameStates            GameState[]
  jumpBalls             JumpBall[]
  events                MatchEvent[]
  periods               MatchPeriod[]
  matchPlayers          MatchPlayer[]
  gameRules             GameRules?        @relation(fields: [gameRulesId], references: [id])
  league                League?           @relation(fields: [leagueId], references: [id])
  leagueSeason          LeagueSeason?     @relation("LeagueSeasonMatches", fields: [leagueSeasonId], references: [id], onDelete: SetNull)
  nextLoserMatch        Match?            @relation("NextLoserMatches", fields: [nextLoserMatchId], references: [id])
  previousLoserMatches  Match[]           @relation("NextLoserMatches")
  nextWinnerMatch       Match?            @relation("NextWinnerMatches", fields: [nextWinnerMatchId], references: [id])
  previousWinnerMatches Match[]           @relation("NextWinnerMatches")
  possessionTeam        Team?             @relation("PossessionMatches", fields: [possessionTeamId], references: [id])
  season                Season?           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team1                 Team?             @relation("Team1Matches", fields: [team1Id], references: [id])
  team2                 Team?             @relation("Team2Matches", fields: [team2Id], references: [id])
  winner                Team?             @relation("WinnerMatches", fields: [winnerId], references: [id])
  staffMatchSheets      StaffMatchSheet[]
  substitutions         Substitution[]
  timeouts              Timeout[]

  @@index([date])
  @@index([status])
  @@index([resultPublishedAt])
  @@index([status, date], map: "matches_status_date_idx")
  @@index([status, resultPublishedAt, date], map: "matches_results_feed_idx")
  @@index([stage])
  @@index([team1Id])
  @@index([team2Id])
  @@index([leagueId])
  @@index([seasonId])
  @@index([leagueSeasonId])
  @@index([leagueSeasonId, date], map: "matches_league_season_date_idx")
  @@index([seasonId, date], map: "matches_season_date_idx")
  @@index([gameRulesId])
  @@index([possessionTeamId])
  @@index([winnerId])
  @@index([nextWinnerMatchId])
  @@index([nextLoserMatchId])
  @@index([bracketPosition])
  @@index([bracketRound])
  @@index([bracketType])
  @@map("matches")
}

model Team {
  id                             String                          @id @default(cuid())
  name                           String                          @unique
  logo                           String?
  description                    String?
  approved                       Boolean                         @default(false)
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  slug                           String                          @unique
  nickname                       String?
  shortName                      String?                         @map("short_name")
  abbreviation                   String?
  venue                          String?
  city                           String?
  founded                        Int?
  contactEmail                   String?                         @map("contact_email")
  primaryColor                   String?                         @map("primary_color")
  secondaryColor                 String?                         @map("secondary_color")
  jumpBallPossession             JumpBall[]                      @relation("JumpBallPossession")
  matchEvents                    MatchEvent[]
  matchPlayers                   MatchPlayer[]
  possessionMatches              Match[]                         @relation("PossessionMatches")
  team1Matches                   Match[]                         @relation("Team1Matches")
  team2Matches                   Match[]                         @relation("Team2Matches")
  winnerMatches                  Match[]                         @relation("WinnerMatches")
  players                        Player[]
  notifications                  RegistrationNotification[]
  substitutions                  Substitution[]
  staff                          TeamStaff[]
  coachingStaff                  TeamStaffMember[]
  staffMatchSheets               StaffMatchSheet[]
  staffTransfersFrom             StaffTransfer[]                 @relation("StaffTransferFromTeam")
  staffTransfersTo               StaffTransfer[]                 @relation("StaffTransferToTeam")
  timeouts                       Timeout[]
  teamHistory                    PlayerTeamHistory[]
  seasonTeams                    SeasonTeam[]
  seasonRegistrationApplications SeasonRegistrationApplication[]
  ownerships                     TeamOwnership[]
  ownershipClaims                TeamOwnershipClaim[]
  seasonTeamPlayers              SeasonTeamPlayer[]

  @@index([name])
  @@index([slug])
  @@index([approved])
  @@index([approved, name], map: "teams_public_directory_idx")
  @@map("teams")
}

model SeasonTeam {
  id                       String                          @id @default(cuid())
  seasonId                 String                          @map("season_id")
  leagueId                 String                          @map("league_id")
  leagueSeasonId           String                          @map("league_season_id")
  teamId                   String                          @map("team_id")
  conferenceId             String?                         @map("conference_id")
  featured                 Boolean                         @default(false)
  createdAt                DateTime                        @default(now()) @map("created_at")
  season                   Season                          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  league                   League                          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueSeason             LeagueSeason                    @relation("LeagueSeasonTeams", fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  team                     Team                            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conference               Conference?                     @relation(fields: [conferenceId], references: [id], onDelete: SetNull)
  players                  SeasonTeamPlayer[]
  registrationApplications SeasonRegistrationApplication[]
  transfersFrom            SeasonPlayerTransfer[]          @relation("TransferFromTeam")
  transfersTo              SeasonPlayerTransfer[]          @relation("TransferToTeam")
  rosterHistory            SeasonRosterHistory[]

  @@unique([leagueSeasonId, teamId])
  @@index([seasonId])
  @@index([leagueId])
  @@index([leagueSeasonId])
  @@index([teamId])
  @@index([conferenceId])
  @@map("season_teams")
}

// A season-specific request to enter a new or returning team. This is append-only;
// approving it creates a SeasonTeam without changing historical seasons.
model SeasonRegistrationApplication {
  id                String                           @id @default(cuid())
  leagueSeasonId    String                           @map("league_season_id")
  teamId            String?                          @map("team_id")
  requestedTeamName String?                          @map("requested_team_name")
  type              SeasonRegistrationType
  status            SeasonRegistrationStatus         @default(PENDING)
  applicantName     String                           @map("applicant_name")
  applicantEmail    String                           @map("applicant_email")
  notes             String?                          @db.Text
  adminNotes        String?                          @map("admin_notes") @db.Text
  reviewedById      String?                          @map("reviewed_by_id")
  reviewedAt        DateTime?                        @map("reviewed_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")
  leagueSeason      LeagueSeason                     @relation(fields: [leagueSeasonId], references: [id], onDelete: Cascade)
  team              Team?                            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  reviewedBy        User?                            @relation("SeasonRegistrationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  ownershipClaim    TeamOwnershipClaim?
  rosterChanges     SeasonRegistrationRosterChange[]
  seasonTeam        SeasonTeam?                      @relation(fields: [seasonTeamId], references: [id], onDelete: SetNull)
  seasonTeamId      String?                          @map("season_team_id")

  @@index([leagueSeasonId, status])
  @@index([teamId])
  @@index([applicantEmail])
  @@map("season_registration_applications")
}

model TeamOwnershipClaim {
  id            String                        @id @default(cuid())
  applicationId String                        @unique @map("application_id")
  teamId        String                        @map("team_id")
  email         String
  tokenHash     String                        @unique @map("token_hash")
  status        OwnershipClaimStatus          @default(PENDING)
  expiresAt     DateTime                      @map("expires_at")
  verifiedAt    DateTime?                     @map("verified_at")
  createdAt     DateTime                      @default(now()) @map("created_at")
  application   SeasonRegistrationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  team          Team                          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([expiresAt])
  @@map("team_ownership_claims")
}

model TeamOwnership {
  id            String    @id @default(cuid())
  teamId        String    @map("team_id")
  userId        String?   @map("user_id")
  email         String
  role          String    @default("OWNER")
  verifiedAt    DateTime  @map("verified_at")
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId, revokedAt, effectiveFrom, effectiveTo], map: "team_ownership_scope_idx")
  @@index([email])
  @@map("team_ownerships")
}

model SeasonRegistrationRosterChange {
  id            String                        @id @default(cuid())
  applicationId String                        @map("application_id")
  playerId      String                        @map("player_id")
